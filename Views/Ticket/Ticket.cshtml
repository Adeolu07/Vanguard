@model List<Booking>
@using _Tripfinity.Models.Tables

@{
    Layout = null;
    ViewData["Title"] = "My Tickets";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tripfinity</title>
    <link rel="stylesheet" href="~/css/bus-trips.css" />
    <link rel="stylesheet" href="~/css/ticket.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="dashboard-layout">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="brand-logo" style="line-height: 1.2; font-weight: 700; font-size: 20px; color: #0f172a;">
                Tripfinity<br>
                <span style="font-size:11px; font-weight:400; color:#64748b;">Smart Transport</span>
            </div>
            <nav class="sidebar-nav" style="margin-top: 32px; display: flex; flex-direction: column; gap: 8px;">
                <a href="/Ticket/Index" class="nav-item active">My Tickets</a>
                <a href="/BusTrips/Index" class="nav-item">Book a Bus</a>
                <a href="/TaxiTrips/Index" class="nav-item">Book a Taxi</a>
                <a href="/RailwayTrips/Index" class="nav-item">Book a Train</a>
                <a href="/Wallet/Index" class="nav-item">Wallet</a>
            </nav>
            <div class="user-profile-tag" style="padding: 16px 0; border-top: 1px solid #e2e8f0; margin-top: auto;">
                <div style="font-size: 14px; font-weight: 700; color: #0f172a;">@(ViewBag.FirstName ?? "Passenger")</div>
                <div style="font-size: 11px; font-weight: 400; color: #64748b; margin-top: 2px;">Verified Member</div>
            </div>
        </aside>

        <!-- Main Workspace -->
        <main class="main-content" style="flex: 1; padding: 40px; background: #f8fafc; min-height: 100vh;">
            <header class="top-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 20px; margin-bottom: 32px;">
                <div style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase;">Passenger Dashboard</div>
                <div class="header-meta" style="display: flex; align-items: center; gap: 16px;">
                    <span>Hello, @(ViewBag.FirstName ?? "Passenger")</span>
                    <a href="/Auth/Logout" class="btn-signout">Sign Out</a>
                </div>
            </header>

            <section style="margin-bottom: 32px;">
                <h1>My Tickets</h1>
            </section>

            @if (Model != null && Model.Any())
            {
                <!-- Detailed Ticket List -->
                <div class="tickets-list">
                    @foreach (var booking in Model)
                    {
                        <div class="ticket-card">
                            <div class="ticket-header">
                                <div class="ticket-type">
                                    @if (booking.BusTrip != null)
                                    {
                                        <span>🚌 Bus Ticket</span>
                                    }
                                    else if (booking.TaxiTrip != null)
                                    {

                                        <span>🚕 Taxi Ticket</span>
                                    }
                                    else if (booking.RailwayTrip != null)
                                    {

                                        <span>🚆 Railway Ticket</span>
                                    }
                                </div>
                                <div class="ticket-status @booking.Status.ToString().ToLower()">
                                    @booking.Status
                                </div>
                            </div>

                            <div class="ticket-body">
                                @if (booking.BusTrip != null)
                                {
                                    <div class="ticket-route">@booking.BusTrip.From → @booking.BusTrip.Destination</div>
                                    <div class="ticket-datetime">📅 @booking.BusTrip.DepartureTime.ToString("MMM dd, yyyy - hh:mm tt")</div>
                                }
                                else if (booking.TaxiTrip != null)
                                {
                                    <div class="ticket-route">@booking.TaxiTrip.PickupLocation → @booking.TaxiTrip.DropoffLocation</div>
                                    <div class="ticket-datetime">📅 @booking.TaxiTrip.PickupTime.ToString("MMM dd, yyyy - hh:mm tt")</div>
                                }
                                else if (booking.RailwayTrip != null)
                                {
                                    <div class="ticket-route">@booking.RailwayTrip.From → @booking.RailwayTrip.Destination</div>
                                    <div class="ticket-datetime">📅 @booking.RailwayTrip.DepartureTime.ToString("MMM dd, yyyy - hh:mm tt")</div>
                                    <div class="ticket-class">🚂 Class: @booking.RailwayTrip.TrainClass</div>
                                }

                                <div class="ticket-details-row">
                                    <span>🎫 Seats: @booking.NumberOfSeats</span>
                                    <span>💰 ₦@booking.TotalAmount.ToString("N0")</span>
                                    <span>📅 Booked: @booking.BookingDate.ToString("MMM dd, yyyy")</span>
                                </div>

                                <!-- QR preview (requires tickets collection from controller) -->
                                @* Uncomment if you pass tickets from controller *@
                                @* <div class="ticket-qr">
                                    @if (booking.QrCodeBase64 != null)
                                    {
                                        <img src="data:image/png;base64,@booking.QrCodeBase64" alt="QR Code" class="qr-container__image" />
                                    }
                                </div> *@
                            </div>

                            <div class="ticket-footer">
                                <a href="/Ticket/Details/@booking.Id" class="btn-view">View Ticket →</a>
                            </div>
                        </div>
                    }
                </div>

                <!-- Gallery Grid -->
                <div class="ticket-gallery-grid">
                    @foreach (var booking in Model)
                    {
                        <a href="/Ticket/Details/@booking.Id" class="ticket-display-card">
                            <div>
                                <div class="ticket-card-route">
                                    @if (booking.BusTrip != null)
                                    {
                                        <span>@booking.BusTrip.From → @booking.BusTrip.Destination</span>
                                    }
                                    else if (booking.TaxiTrip != null)
                                    {

                                        <span>@booking.TaxiTrip.PickupLocation → @booking.TaxiTrip.DropoffLocation</span>
                                    }
                                    else if (booking.RailwayTrip != null)
                                    {

                                        <span>@booking.RailwayTrip.From → @booking.RailwayTrip.Destination</span>
                                    }
                                </div>

                                <div class="ticket-card-meta-line">
                                    @if (booking.BusTrip != null)
                                    {
                                        <span>@booking.BusTrip.DepartureTime.ToString("MMM dd, yyyy")</span>
                                    }
                                    else if (booking.TaxiTrip != null)
                                    {

                                        <span>@booking.TaxiTrip.PickupTime.ToString("MMM dd, yyyy")</span>
                                    }
                                    else if (booking.RailwayTrip != null)
                                    {

                                        <span>@booking.RailwayTrip.DepartureTime.ToString("MMM dd, yyyy")</span>
                                    }
                                </div>

                                <div class="ticket-card-time-line">
                                    @if (booking.BusTrip != null)
                                    {
                                        <span>@booking.BusTrip.DepartureTime.ToString("hh:mm tt")</span>
                                    }
                                    else if (booking.TaxiTrip != null)
                                    {

                                        <span>@booking.TaxiTrip.PickupTime.ToString("hh:mm tt")</span>
                                    }
                                    else if (booking.RailwayTrip != null)
                                    {

                                        <span>@booking.RailwayTrip.DepartureTime.ToString("hh:mm tt")</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }

                    <!-- Shortcut booking trigger -->
                    <a href="/BusTrips/Index" class="ticket-creation-placeholder-box">
                        <div class="ticket-plus-circle">+</div>
                        <div>Book a new trip</div>
                        <div>Bus, Taxi, or Train</div>
                    </a>
                </div>
            }

            <footer class="system-footer" style="margin-top: 120px; padding-top: 20px; border-top: 1px solid #e2e8f0; font-size: 12px; color: #94a3b8; text-align: center;">
                &copy; 2026 Tripfinity Ecosystem. All rights reserved.
            </footer>
        </main>
    </div>
</body>
</html>
