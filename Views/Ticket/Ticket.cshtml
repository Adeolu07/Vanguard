@model List<Booking>
@using _Tripfinity.Models.Tables

@{
    Layout = "_Layout";
    ViewData["Title"] = "My Tickets";
    var tickets = ViewBag.Tickets as List<Ticket>;
}

<div class="tickets-header">
    <h2>🎫 My Tickets</h2>
    <p>View all your booked tickets</p>
</div>

@if (Model.Any())
{
    <div class="tickets-list">
        @foreach (var booking in Model)
        {
            var ticket = tickets?.FirstOrDefault(t => t.BookingId == booking.Id);

            <div class="ticket-card">
                <div class="ticket-header">
                    <div class="ticket-type">
                        @if (booking.BusTrip != null)
                        {
                            <span>🚌 Bus Ticket</span>
                        }
                        else if (booking.TaxiTrip != null)
                        {
                            <span>🚕 Taxi Ticket</span>
                        }
                        else if (booking.RailwayTrip != null)
                        {
                            <span>🚆 Railway Ticket</span>
                        }
                    </div>
                    <div class="ticket-status @booking.Status.ToString().ToLower()">
                        @booking.Status
                    </div>
                </div>

                <div class="ticket-body">
                    @if (booking.BusTrip != null)
                    {
                        <div class="ticket-route">@booking.BusTrip.From → @booking.BusTrip.Destination</div>
                        <div class="ticket-datetime">📅 @booking.BusTrip.DepartureTime.ToString("MMM dd, yyyy - hh:mm tt")</div>
                    }
                    else if (booking.TaxiTrip != null)
                    {
                        <div class="ticket-route">@booking.TaxiTrip.PickupLocation → @booking.TaxiTrip.DropoffLocation</div>
                        <div class="ticket-datetime">📅 @booking.TaxiTrip.PickupTime.ToString("MMM dd, yyyy - hh:mm tt")</div>
                    }
                    else if (booking.RailwayTrip != null)
                    {
                        <div class="ticket-route">@booking.RailwayTrip.From → @booking.RailwayTrip.Destination</div>
                        <div class="ticket-datetime">📅 @booking.RailwayTrip.DepartureTime.ToString("MMM dd, yyyy - hh:mm tt")</div>
                        <div class="ticket-class">🚂 Class: @booking.RailwayTrip.TrainClass</div>
                    }

                    <div class="ticket-details-row">
                        <span>🎫 Seats: @booking.NumberOfSeats</span>
                        <span>💰 ₦@booking.TotalAmount.ToString("N0")</span>
                        <span>📅 Booked: @booking.BookingDate.ToString("MMM dd, yyyy")</span>
                    </div>

                    <!-- QR preview -->
                    <div class="ticket-qr">
                        @if (ticket != null && !string.IsNullOrEmpty(ticket.QrCodeBase64))
                        {
                            <img src="data:image/png;base64,@ticket.QrCodeBase64"
                                 alt="QR Code"
                                 class="qr-container__image" />
                        }
                    </div>
                </div>

                <div class="ticket-footer">
                    <a href="/Ticket/Details/@booking.Id" class="btn-view">View Ticket →</a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-icon">🎫</div>
        <h3>No tickets yet</h3>
        <p>You haven't booked any trips. Start your first journey!</p>
        <a href="/BusTrips/Index" class="btn-primary">Book a Trip →</a>
    </div>
}
