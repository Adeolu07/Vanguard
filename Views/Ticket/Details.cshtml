@using _Tripfinity.Models.Enums
@using _Tripfinity.Services
@model _Tripfinity.Models.ViewModels.BookingDetailViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Ticket Details";
    ViewData["ActiveNav"] = "Tickets";
}
@section Styles {
    <link rel="stylesheet" href="~/css/ticket-details.css" />
}

<header class="top-header">
    <h2>Ticket Details</h2>
    <a href="/Auth/Logout" class="btn-signout">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
        Sign Out
    </a>
</header>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 16px;">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 16px;">@TempData["Error"]</div>
}

<div class="ticket-details-container">
    <div class="ticket-details-card">
        <div class="ticket-header">
            <div class="ticket-header-left">
                <div class="ticket-icon">
                    @if (Model.Booking.BusTrip != null) { <span>🚌</span> }
                    else if (Model.Booking.TaxiTrip != null) { <span>🚕</span> }
                    else if (Model.Booking.RailwayTrip != null) { <span>🚆</span> }
                </div>
                <div>
                    <h2>@Model.Booking.TransportType Ticket</h2>
                    <p>Booking ID: #@Model.Booking.Id</p>
                </div>
            </div>
            <div class="ticket-status">@Model.Booking.Status</div>
        </div>

        <div class="ticket-route-info">
            @if (Model.Booking.BusTrip != null)
            {
                <div class="route-stations">
                    <div class="station">
                        <div class="station-name">@Model.Booking.BusTrip.From</div>
                        <div class="station-label">Departure</div>
                    </div>
                    <div class="route-line">→</div>
                    <div class="station">
                        <div class="station-name">@Model.Booking.BusTrip.Destination</div>
                        <div class="station-label">Arrival</div>
                    </div>
                </div>
                <div class="ticket-info-grid">
                    <div><strong>Departure Time</strong><br>@Model.Booking.BusTrip.DepartureTime.ToString("dddd, MMM dd yyyy - hh:mm tt")</div>
                </div>
            }
            else if (Model.Booking.TaxiTrip != null)
            {
                <div class="route-stations">
                    <div class="station">
                        <div class="station-name">@Model.Booking.TaxiTrip.PickupLocation</div>
                        <div class="station-label">Pickup</div>
                    </div>
                    <div class="route-line">→</div>
                    <div class="station">
                        <div class="station-name">@Model.Booking.TaxiTrip.DropoffLocation</div>
                        <div class="station-label">Dropoff</div>
                    </div>
                </div>
                <div class="ticket-info-grid">
                    <div><strong>Pickup Time</strong><br>@Model.Booking.TaxiTrip.PickupTime.ToString("dddd, MMM dd yyyy - hh:mm tt")</div>
                </div>
            }
            else if (Model.Booking.RailwayTrip != null)
            {
                <div class="route-stations">
                    <div class="station">
                        <div class="station-name">@Model.Booking.RailwayTrip.From</div>
                        <div class="station-label">Departure</div>
                    </div>
                    <div class="route-line">→</div>
                    <div class="station">
                        <div class="station-name">@Model.Booking.RailwayTrip.Destination</div>
                        <div class="station-label">Arrival</div>
                    </div>
                </div>
                <div class="ticket-info-grid">
                    <div><strong>Departure Time</strong><br>@Model.Booking.RailwayTrip.DepartureTime.ToString("dddd, MMM dd yyyy - hh:mm tt")</div>
                    <div><strong>Train Class</strong><br>@Model.Booking.RailwayTrip.TrainClass</div>
                </div>
            }
        </div>

        <div class="qr-section">
            <div class="qr-code">
                @if (Model.Ticket != null && !string.IsNullOrEmpty(Model.Ticket.QrCodeBase64))
                {
                    <img src="data:image/png;base64,@Model.Ticket.QrCodeBase64" alt="QR Code" style="width:150px; height:150px;" />
                }
                else
                {
                    <div class="qr-placeholder">
                        📱 QR CODE
                        <div class="qr-text">@Model.QrCodeText</div>
                    </div>
                }
            </div>
            <p class="qr-note">Show this QR code to the marshal for validation</p>
        </div>

        <div class="ticket-footer-details">
            <div class="passenger-info">
                <h4>Passenger Details</h4>
                <p><strong>Name:</strong> @Model.Booking.User?.FirstName @Model.Booking.User?.LastName</p>
                <p><strong>Email:</strong> @Model.Booking.User?.Email</p>
            </div>
            <div class="booking-info">
                <h4>Booking Details</h4>
                <p><strong>Seats:</strong> @Model.Booking.NumberOfSeats</p>
                <p><strong>Total Paid:</strong> ₦@Model.Booking.TotalAmount.ToString("N0")</p>
                <p><strong>Booked On:</strong> @Model.Booking.BookingDate.ToString("MMMM dd, yyyy - hh:mm tt")</p>
            </div>
        </div>

        <div class="ticket-actions">
            <a href="/Ticket/Index" class="btn-secondary">← Back to Tickets</a>
            <button onclick="window.print()" class="btn-primary">Print Ticket 🖨️</button>
        </div>
        @* -- Cancel button (only if not already cancelled) -- *@
        @if (Model.Booking.Status != BookingStatus.Cancelled)
        {
            <div style="margin-top: 24px; text-align: center;">
                <button id="cancelBookingBtn" class="btn-cancel" style="background: #ef4444; color: #fff; padding: 10px 24px; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">Cancel Booking</button>
            </div>
        }
    </div>
</div>

@* -- Confirmation Modal -- *@
<div id="cancelModal" class="modal-overlay" style="display:none;">
    <div class="modal-card">
        <h3>Cancel Booking</h3>
        <p>Are you sure you want to cancel this booking?</p>
        <form id="cancelForm" method="post" asp-action="Cancel" asp-controller="Ticket">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bookingId" value="@Model.Booking.Id" />
            <input type="hidden" name="reason" value="Cancelled by passenger" />
            <div class="modal-actions">
                <button type="button" id="closeModalBtn" class="btn-secondary">No, Keep It</button>
                <button type="submit" class="btn-primary">Yes, Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/tickets-cancel.js"></script>
}