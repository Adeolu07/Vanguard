@{
    ViewData["Title"] = "Signup Decision";
    Layout = "_AuthLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/decision.css" />
}

<header>
    <div class="header-container">
        <p class="brand-logo">Tripfinity</p>
        <p class="header-action">Create an account</p>
    </div>
</header>

<main class="content-container">
    <div class="decision-box">
        <h1 class="decision-title">Sign up as a</h1>

        <div class="button-group">
            <a asp-controller="Auth" asp-action="SignUp" class="btn-selection">Passenger</a>
            <a asp-controller="Auth" asp-action="MarshalSignUp" class="btn-selection">Marshal</a>
        </div>
    </div>
</main>
