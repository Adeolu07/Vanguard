@model _Tripfinity.Models.ViewModels.LoginViewModel

@{

    ViewData["Title"] = "Sign In";
    Layout = null; /* Completely bypasses outer layout wrappers */
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tripfinity</title>

    <!-- asp-append-version="true" forces browser to fetch the fresh CSS file instead of reading cache -->
    <link rel="stylesheet" href="~/css/SignIn.css" asp-append-version="true" />
</head>
<body>

    <div class="passenger-page-container">
        
        <!-- Left Column: Form & Content -->
        <div class="left-content-area">
            
            <!-- Logo -->
            <div class="brand-logo">Tripfinity</div>

            <!-- Form Wrapper -->
            <main class="form-section">
                <h1 class="page-title">Sign in and start<br />commuting</h1>

                @* TempData & Validation Error Messages *@
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="error-summary">⚠️ @TempData["ErrorMessage"]</div>
                }

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="error-summary">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>⚠️ @error.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-action="SignIn" method="post" class="login-form">
                    <div class="form-group">
                        <input asp-for="Email" class="input-field" type="text" placeholder="Enter email or phone number" />
                        <span asp-validation-for="Email" class="error-text"></span>
                    </div>

                    <div class="form-group">
                        <input asp-for="Password" class="input-field" type="password" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="error-text"></span>
                    </div>

                    <div class="forgot-link-wrapper">
                        <a asp-action="ForgotPassword" class="forgot-password-link">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-continue">Continue</button>

                    <div class="signup-redirect">
                        <span class="signup-text">Don't have an account?</span>
                        <a href="/Auth/DecisionSignup" class="signup-link">Sign up &rarr;</a>
                    </div>
                </form>
            </main>

            <!-- Footer -->
            <footer class="footer-copyright">
                &copy; 2026 Tripfinity Ecosystem. All rights reserved.
            </footer>

        </div>

        <!-- Right Column: Curved Light Gray Graphic Panel -->
        <div class="right-graphic-panel"></div>

    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
