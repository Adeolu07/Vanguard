@model _Tripfinity.Models.ViewModels.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

@section Styles {
    <link rel="stylesheet" href="~/css/reset-password.css" asp-append-version="true" />
}

<header class="auth-header">
    <div class="header-container">
        <span class="brand-logo">Tripfinity</span>
        <a href="/Auth/DecisionLogin" class="header-link">Back to Sign In</a>
    </div>
</header>

<main class="content-container">
    <div class="reset-box">
        <div class="reset-icon">🔐</div>
        <h1 class="reset-title">Reset your password</h1>
        <p class="reset-subtitle">Enter a new password for your account.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <span>@error.ErrorMessage</span>
                }
            </div>
        }

        <form asp-action="ResetPassword" method="post" class="reset-form" novalidate>
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="form-group">
                <label asp-for="NewPassword">New Password</label>
                <input asp-for="NewPassword" type="password" placeholder="At least 8 characters" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" placeholder="Re-enter your password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn-reset">Reset Password</button>
        </form>
    </div>
</main>