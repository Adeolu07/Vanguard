@model _Tripfinity.Models.ViewModels.ResetPasswordViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Reset Password";
}

<div class="auth-container">
    <h2>Reset Password</h2>
    <form asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div class="form-group">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" class="form-control" required />
            <span asp-validation-for="NewPassword" class="error"></span>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="form-control" required />
            <span asp-validation-for="ConfirmPassword" class="error"></span>
        </div>
        <button type="submit" class="btn-primary">Reset Password</button>
    </form>
</div>