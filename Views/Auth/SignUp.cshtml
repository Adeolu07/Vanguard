@model _Tripfinity.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Passenger Sign Up";
    Layout = "_AuthLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/SignUp.css" />
}

@{
    ViewData["HideNavbar"] = true;
}

<header>
    <div class="nav-container">
        <p>Tripfinity</p>
    </div>
</header>

<main class="page-container">
    <section class="form-section">
        <h1 class="page-title">Sign up</h1>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">✅ @TempData["Success"]</div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="validation-summary">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>⚠️ @error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="SignUp" method="post" class="signup-grid">
            <div class="form-group">
                <input asp-for="FirstName" placeholder="First Name" />
                <span asp-validation-for="FirstName" class="error"></span>
            </div>

            <div class="form-group">
                <input asp-for="LastName" placeholder="Last Name" />
                <span asp-validation-for="LastName" class="error"></span>
            </div>

            <div class="form-group">
                <input asp-for="Email" type="email" placeholder="Email Address" />
                <span asp-validation-for="Email" class="error"></span>
            </div>

            <div class="form-group">
                <input asp-for="PhoneNumber" type="tel" placeholder="Phone Number" />
                <span asp-validation-for="PhoneNumber" class="error"></span>
            </div>

            <div class="form-group">
                <input asp-for="Password" type="password" placeholder="Password" />
                <span asp-validation-for="Password" class="error"></span>
            </div>

            <div class="form-group">
                <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" />
                <span asp-validation-for="ConfirmPassword" class="error"></span>
            </div>

            <div class="btn-container">
                <button type="submit" class="btn-submit">Continue</button>
            </div>
        </form>
    </section>

    <section class="graphic-side"></section>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
