@model _Tripfinity.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Passenger Sign Up";
    Layout = "_AuthLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/SignUp.css" />
}

@{
    ViewData["HideNavbar"] = true;
}

<!-- Top Header Navigation -->
<header class="top-nav">
    <div class="nav-brand">
        <span class="logo-text">Tripfinity</span>
    </div>
    <div class="nav-actions">
        <a asp-controller="Auth" asp-action="SignIn" class="btn-link">Sign In</a>
    </div>
</header>

<!-- Main Workspace Body -->
<div class="main-wrapper">
    <main class="auth-card">
        <!-- Left Side: Form Content -->
        <section class="form-section">
            <div class="form-header">
                <h1 class="page-title">Sign up</h1>
                <p class="subtitle">Create your passenger account to start your journey.</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">✅ @TempData["Success"]</div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="validation-summary">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>⚠️ @error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="SignUp" method="post" class="signup-grid">
                <div class="form-group">
                    <label asp-for="FirstName">First Name</label>
                    <input asp-for="FirstName" placeholder="John" />
                    <span asp-validation-for="FirstName" class="error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName">Last Name</label>
                    <input asp-for="LastName" placeholder="Doe" />
                    <span asp-validation-for="LastName" class="error"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email" type="email" placeholder="john.doe@example.com" />
                    <span asp-validation-for="Email" class="error"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="PhoneNumber">Phone Number</label>
                    <input asp-for="PhoneNumber" type="tel" placeholder="+1 (555) 000-0000" />
                    <span asp-validation-for="PhoneNumber" class="error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="error"></span>
                </div>

                <div class="btn-container">
                    <button type="submit" class="btn-submit">Continue</button>
                </div>

                <div class="signin-prompt">
                    <span>Already have an account?</span>
                    <a asp-action="SignIn" class="signin-link">Sign in</a>
                </div>
            </form>
        </section>

        <!-- Right Side: Dark Navy Graphic Banner -->
        <section class="graphic-side"></section>
    </main>
</div>

<!-- Footer Section -->
<footer class="footer">
    <div class="footer-content">
        <p class="footer-brand">Tripfinity</p>
        <p class="footer-copyright">© 2026 Tripfinity Ecosystem. All rights reserved.</p>
    </div>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>