@model _Tripfinity.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Marshal Sign Up";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Marshal Sign Up - Transport Booking</title>
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>
    <div class="container">
        <h1>Create Marshal Account</h1>
        <div class="subtitle">Join as a Marshal to manage and oversee trips</div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">✅ @TempData["Success"]</div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="validation-summary">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>⚠️ @error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="MarshalSignUp" method="post">
            <div class="form-group">
                <label asp-for="FirstName">First Name</label>
                <input asp-for="FirstName" placeholder="John" />
                <label asp-for="LastName">Last Name</label>
                <input asp-for="LastName" placeholder="Doe" />
                <span asp-validation-for="FirstName" class="error"></span>
                <span asp-validation-for="LastName" class="error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" type="email" placeholder="marshal@example.com" />
                <span asp-validation-for="Email" class="error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" placeholder="••••••" />
                <span asp-validation-for="Password" class="error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" placeholder="••••••" />
                <span asp-validation-for="ConfirmPassword" class="error"></span>
            </div>

            <button type="submit" class="btn">Sign Up →</button>
        </form>

        <div class="login-link">
            Already a Marshal? <a asp-action="MarshalSignIn">Sign In</a>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
