@model _Tripfinity.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - Transport Booking</title>
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>
    <div class="container">

        <h1>Forgot Password?</h1>
        <div class="subtitle">Enter your email to reset your password</div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="validation-summary">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>⚠️ @error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" type="email" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="error"></span>
            </div>

            <button type="submit" class="btn">Send Reset Link →</button>
        </form>

        <div class="login-link">
            Remembered your password? <a asp-action="SignIn">Sign In</a>
        </div>
    </div>
</body>
</html>
