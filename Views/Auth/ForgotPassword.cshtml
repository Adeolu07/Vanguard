@model _Tripfinity.Models.ViewModels.MarshalRegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

@section Styles {
    <link rel="stylesheet" href="~/css/forgot-password.css" asp-append-version="true" />
}

<main class="content-container">
    <div class="forgot-box">
        <div class="forgot-icon">🔑</div>
        <h1 class="forgot-title">Forgot your password?</h1>
        <p class="forgot-subtitle">No worries. Enter your email and we'll send you a reset link.</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }
        else if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                @TempData["Error"]
            </div>
        }

        <form asp-action="ForgotPassword" method="post" class="forgot-form">
            <div class="form-group">
                <label>Email address</label>
                <input type="email" name="email" id="email" placeholder="you@example.com" required />
            </div>
            <button type="submit" class="btn-send">Send Reset Link</button>
        </form>
    </div>
</main>