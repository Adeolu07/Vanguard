@{
    ViewData["Title"] = "Login Decision";
    Layout = "_AuthLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/decision.css" asp-append-version="true" />
}

    <main class="content-container">
        <div class="decision-box">
            <h1 class="decision-title">Login as a</h1>

            <div class="button-group">
                <a asp-controller="Auth" asp-action="SignIn" class="btn-selection">Passenger</a>
                <a asp-controller="Auth" asp-action="MarshalSignIn" class="btn-selection">Marshal</a>
            </div>
            <p class="signup-redirect">
                Don't have an account? <a href="/Auth/DecisionSignup">Create one!</a>
            </p>
        </div>
    </main>