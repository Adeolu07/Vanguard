@{
    ViewData["Title"] = "Wallet";
    Layout = "_DashboardLayout";
    ViewData["ActiveNav"] = "Wallet";
}
@section Styles {
    <link rel="stylesheet" href="~/css/wallet.css" />
}

<header class="top-header">
    <h2>Wallet</h2>
    <a href="/Auth/Logout" class="btn-signout">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
        Sign Out
    </a>
</header>

<section class="welcome-section">
    <span class="sub-brand">FINANCE</span>
    <h1>My Wallet</h1>
    <p>Check your balance and add funds.</p>
</section>

<section class="balance-banner">
    <span class="balance-label">CURRENT BALANCE</span>
    <div class="balance-wrapper">
        <h1 id="walletBalance">Loading...</h1>
    </div>
    <div class="status-badge">
        <span class="dot"></span> Active & Secure
    </div>
</section>

<div class="fund-wallet">
    <h4>Add Funds</h4>
    <div class="fund-form">
        <input type="number" id="fundAmount" placeholder="Amount (₦)" min="1" step="100" />
        <input type="text" id="fundDescription" placeholder="Description (optional)" />
        <button id="fundButton">Add Funds</button>
    </div>
    <div id="fundMessage" class="message"></div>
</div>

<input type="hidden" id="walletId" value="@ViewBag.WalletId" />

<footer class="dashboard-footer-text">
    &copy; 2026 Tripfinity Ecosystem. All rights reserved.
</footer>

@section Scripts {
    <script src="~/js/site.js"></script>
}