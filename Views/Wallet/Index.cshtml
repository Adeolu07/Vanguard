@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}
@section Styles
{
    <link rel="stylesheet" href="~/css/wallet.css"/>
}

<div class="wallet-container">
    <h2>My Wallet</h2>
    <div class="balance-card">
        <h3>Current Balance</h3>
        <span id="balanceAmount" class="balance">Loading...</span>
    </div>

    <div class="fund-wallet">
        <h4>Add Funds</h4>
        <div class="fund-form">
            <input type="number" id="fundAmount" placeholder="Amount (₦)" min="1" step="100" />
            <input type="text" id="fundDescription" placeholder="Description (optional)" />
            <button id="fundButton" class="btn-primary">Add Funds</button>
        </div>
        <div id="fundMessage" class="message"></div>
    </div>
</div>
<h2>title</h2>


@section Scripts {
    <script>
        async function loadBalance() {
            const balanceEl = document.getElementById('balanceAmount');
            balanceEl.textContent = 'Loading...';

            try {
                const res = await fetch('/api/wallet/my-balance');
                if (res.status === 401) {
                    balanceEl.textContent = 'Please sign in to view your balance';
                    return;
                }
                const data = await res.json();
                if (data.success) {
                    balanceEl.textContent = `₦${data.balance.toLocaleString()}`;
                } else {
                    balanceEl.innerHTML = `Unable to fetch balance. <a href="#" onclick="loadBalance();return false;">Retry</a>`;
                }
            } catch (err) {
                balanceEl.innerHTML = `Network error. <a href="#" onclick="loadBalance();return false;">Retry</a>`;
            }
        }

        document.getElementById('fundButton').addEventListener('click', async () => {
            const amount = parseFloat(document.getElementById('fundAmount').value);
            if (isNaN(amount) || amount <= 0) {
                document.getElementById('fundMessage').innerHTML = '<span class="error">Enter a valid amount</span>';
                return;
            }
            const desc = document.getElementById('fundDescription').value;
            document.getElementById('fundButton').disabled = true;
            document.getElementById('fundMessage').innerHTML = 'Funding...';

            try {
                const res = await fetch('/api/wallet/my-fund', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ amount: amount, description: desc })
                });
                const data = await res.json();
                if (data.success) {
                    document.getElementById('fundMessage').innerHTML = `<span class="success">✅ ${data.message} – New balance: ₦${data.balance.toLocaleString()}</span>`;
                    loadBalance(); // refresh
                } else {
                    document.getElementById('fundMessage').innerHTML = `<span class="error">❌ ${data.message || 'Unknown error'}</span>`;
                }
            } catch (err) {
                document.getElementById('fundMessage').innerHTML = '<span class="error">Network error</span>';
            } finally {
                document.getElementById('fundButton').disabled = false;
            }
        });

        loadBalance();
    </script>
}