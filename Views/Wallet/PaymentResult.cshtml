@{
    Layout = "_DashboardLayout";
    bool success = ViewBag.Success == true;
    bool pending = ViewBag.Pending == true;
    decimal amount = ViewBag.Amount ?? 0;
    ViewData["Title"] = pending ? "Payment Pending" : success ? "Payment Successful" : "Payment Failed";
}
@section Styles {
    <link rel="stylesheet" href="~/css/payment-result.css" />
}

<header class="top-header">
    <h2>Wallet</h2>
    <a href="/Auth/Logout" class="btn-signout">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
        Sign Out
    </a>
</header>

<div class="result-card">
    @if (pending)
    {
        <div class="result-icon">⏳</div>
        <h2 class="text-warning">Processing Payment</h2>
        <p>Processing your payment of</p>
        <h1>₦@amount.ToString("N2")</h1>
        <p style="font-size:13px; color:#94a3b8;">Please wait while we confirm your transaction...</p>
        <div id="statusMsg" style="margin-top:16px; color:#94a3b8; font-size:13px;"></div>
    }
    else if (success)
    {
        <div class="result-icon">✅</div>
        <h2 class="text-success">Payment Successful</h2>
        <p>Your wallet has been funded with</p>
        <h1>₦@amount.ToString("N2")</h1>
        <p>Your balance has been updated.</p>
        <a href="/Home/Wallet">Back to Wallet</a>
        <a href="/" class="outline">Go Home</a>
    }
    else
    {
        <div class="result-icon">❌</div>
        <h2 class="text-danger">Payment Failed</h2>
        <p>We were unable to fund your wallet.</p>
        <a href="/Home/Wallet">Try Again</a>
        <a href="/" class="outline">Go Home</a>
    }
</div>

@section Scripts {
    <script src="~/js/payment-result.js"></script>
}