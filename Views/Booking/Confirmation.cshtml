@model Booking
@{
    Layout = "_Layout";
    ViewData["Title"] = "Booking Confirmed";
}

<div class="confirmation-container">
    <div class="confirmation-card">
        <div class="confirmation-icon">✅</div>
        <h2>Booking Confirmed!</h2>
        <p>Your trip has been booked successfully.</p>

        <div class="booking-details">
            <h3>Booking Details</h3>
            <p><strong>Booking ID:</strong> #@Model.Id</p>
            @if (Model.BusTrip != null)
            {
                <p><strong>Route:</strong> @Model.BusTrip.From → @Model.BusTrip.Destination</p>
                <p><strong>Departure:</strong> @Model.BusTrip.DepartureTime.ToString("dddd, MMMM dd yyyy - HH:mm")</p>
            }
            @if (Model.RailwayTrip != null)
            {
                <p><strong>Route:</strong> @Model.RailwayTrip.From → @Model.RailwayTrip.Destination</p>
                <p><strong>Train Class:</strong> @Model.RailwayTrip.TrainClass</p>
                <p><strong>Departure:</strong> @Model.RailwayTrip.DepartureTime.ToString("dddd, MMMM dd yyyy - HH:mm")</p>
            }
            @if (Model.TaxiTrip != null)
            {
                <p><strong>Pickup:</strong> @Model.TaxiTrip.PickupLocation → @Model.TaxiTrip.DropoffLocation</p>
                <p><strong>Pickup Time:</strong> @Model.TaxiTrip.PickupTime.ToString("dddd, MMMM dd yyyy - HH:mm")</p>
            }
            <p><strong>Amount Paid:</strong> ₦@Model.TotalAmount.ToString("N0")</p>
            <p><strong>Status:</strong> @Model.Status</p>
            <p><strong>Booked On:</strong> @Model.BookingDate.ToString("MMMM dd yyyy - HH:mm")</p>
        </div>

        @if (ViewBag.PaymentTransaction != null)
        {
            <div class="transaction-details">
                <h3>Payment Transaction</h3>
                <table>
                    <tr><td>Transaction ID</td><td>@ViewBag.PaymentTransaction.TransactionId</td></tr>
                    <tr><td>Amount</td><td>₦@ViewBag.PaymentTransaction.Amount.ToString("N2")</td></tr>
                    <tr><td>Type</td><td>@ViewBag.PaymentTransaction.TranType</td></tr>
                    <tr><td>Description</td><td>@ViewBag.PaymentTransaction.Description</td></tr>
                    <tr><td>Bank / Session</td><td>@(ViewBag.PaymentTransaction.BankName ?? "N/A")</td></tr>
                </table>
            </div>
        }

        <div class="confirmation-actions">
            <a href="/Home" class="btn-book">Book Another Trip</a>
            <a href="/" class="btn-secondary">Back to Home</a>
        </div>
    </div>
</div>