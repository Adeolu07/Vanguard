@{
    Layout = "_Layout";
    ViewData["Title"] = "Confirm Booking";
}


<div class="booking-container">
    <h2>Confirm Your Booking</h2>

    <div class="trip-summary">
        <h3>@ViewBag.From → @ViewBag.To</h3>
        <p>Departure: @ViewBag.DepartureTime</p>
        <p>Price per seat: ₦@ViewBag.Price</p>
        <p>Available seats: @ViewBag.AvailableSeats</p>
    </div>

    <form method="post">
        <input type="hidden" name="tripId" value="@ViewBag.Trip.Id"/>
        <input type="hidden" name="type" value="@ViewBag.TransportType"/>

        <div class="form-group">
            <label for="seats">Number of Seats:</label>
            <input type="number" name="seats" id="seats" min="1" max="@ViewBag.AvailableSeats" required/>
        </div>

        <div class="total-price">
            Total: ₦<span id="totalPrice">0</span>
        </div>

        <button type="submit" class="btn-book">Confirm Booking →</button>
    </form>
</div>


<script>
    const price = @ViewBag.Price;
    const seatsInput = document.getElementById('seats');
    const totalSpan = document.getElementById('totalPrice');

    seatsInput.addEventListener('input', function () {
        const total = price * this.value;
        totalSpan.textContent = total.toLocaleString();
    });

    seatsInput.dispatchEvent(new Event('input'));
</script>