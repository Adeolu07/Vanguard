@model _Tripfinity.Models.ViewModels.MarshalWalletViewModel?
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Wallet";
}

<div class="page-head">
    <div>
        <h1>Admin Wallet</h1>
        <span class="subtitle">Balance & transaction history</span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null){ <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null){ <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

@if (Model != null)
{
    <div class="wallet-card">
        <span class="balance-label">Available Balance</span>
        <div class="balance-value">₦@Model.Balance.ToString("N2")</div>
        <span hidden id="walletCustomerId">@Model.WalletId</span>
    </div>

    <div class="table-wrapper">
        <div class="section-title">Transaction History</div>
        @if (!Model.Transactions!.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">📭</div>
                <p>No transactions yet</p>
            </div>
        }
        else
        {
            @foreach (var txn in Model.Transactions!)
            {
                var isCredit = txn.TranType?.ToLower() == "credit";
                <div class="txn-row">
                    <div class="txn-left">
                        <span class="txn-icon @(isCredit ? "credit" : "debit")">
                            @(isCredit ? "↓" : "↑")
                        </span>
                        <div>
                            <div class="txn-desc">@txn.Description</div>
                            <div class="txn-meta">@txn.TranType · @txn.TransactionId</div>
                        </div>
                    </div>
                    <span class="txn-amount @(isCredit ? "credit" : "debit")">
                        @(isCredit ? "+" : "–")₦@Math.Abs(txn.Amount).ToString("N2")
                    </span>
                </div>
            }

            <div class="pagination">
                @if (Model.HasPrevious)
                {
                    <a href="?page=@(Model.CurrentPage - 1)">Previous</a>
                }
                else
                {
                    <span class="disabled">Previous</span>
                }
                <span class="active">@Model.CurrentPage</span>
                @if (Model.HasNext)
                {
                    <a href="?page=@(Model.CurrentPage + 1)">Next</a>
                }
                else
                {
                    <span class="disabled">Next</span>
                }
            </div>
        }
    </div>
}
else
{
    <p class="empty-state">Wallet information is not available right now.</p>
}