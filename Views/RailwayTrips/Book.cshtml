@model _Tripfinity.Models.Tables.RailwayTrip
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Book Train";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/booking-page.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
}

<a href="/Home/Dashboard" style="display: inline-block; margin-bottom: 16px; color: #64748b; text-decoration: none; font-size: 13px; font-weight: 500;">← Back to Dashboard</a>

@if (TempData["Error"] != null)
{
    <div style="background: #fee2e2; border-left: 4px solid #ef4444; color: #b91c1c; padding: 16px; border-radius: 8px; margin-bottom: 24px; font-weight: 500;">
        ⚠️ @TempData["Error"]
    </div>
}

<div class="railway-booking-wrapper">
    <header style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32px;">
        <div>
            <h2 style="margin: 0 0 6px 0; font-size: 20px; color: #0f172a; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Confirm Train Booking</h2>
            <p style="margin: 0; color: #64748b; font-size: 14px;">Review your travel details and secure your seat on the Tripfinity Express.</p>
        </div>
        <span class="railway-badge-standard">
            @((ViewBag.Trip.TrainClass ?? "Standard Class").ToUpper())
        </span>
    </header>

    <div class="railway-interactive-node">
        <div>
            <span class="railway-node-label">From</span>
            <div class="railway-node-value">@ViewBag.Trip.From</div>
        </div>
        <div>
            <span class="railway-node-label">To</span>
            <div class="railway-node-value">@ViewBag.Trip.Destination</div>
        </div>
    </div>

    <div class="railway-meta-container">
        <div>
            <span class="railway-block-lbl">📅 Departure</span>
            <span class="railway-block-val">
                @(((DateTime)ViewBag.Trip.DepartureTime).ToString("MM/dd/yyyy"))<br>
                <span style="font-size: 12px; color: #64748b; font-weight: 400;">@(((DateTime)ViewBag.Trip.DepartureTime).ToString("h:mm:ss tt"))</span>
            </span>
        </div>
        <div>
            <span class="railway-block-lbl">💺 Capacity</span>
            <span class="railway-block-val">@ViewBag.Trip.AvailableSeats Seats</span>
        </div>
        <div>
            <span class="railway-block-lbl">💵 Price Per Seat</span>
            <span class="railway-block-val">₦@(((decimal)ViewBag.Trip.Price).ToString("N2"))</span>
        </div>
    </div>

    <form method="post" asp-controller="Trips" asp-action="Book">
        <input type="hidden" name="tripId" value="@ViewBag.Trip.Id" />
        <div style="display: flex; justify-content: space-between; align-items: flex-end;">
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <label for="seats" style="font-size: 11px; font-weight:600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px;">Number of Seats</label>
                <input type="number" name="seats" id="seats" min="1" max="@ViewBag.Trip.AvailableSeats" value="1" required class="railway-input-field" />
            </div>
            <div style="text-align: right;">
                <span style="font-size: 11px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 4px;">Total Amount</span>
                <div style="font-size: 28px; font-weight: 700; color: #0f172a;">₦<span id="totalPriceDisplay">0</span></div>
            </div>
        </div>
        <div style="display: flex; justify-content: flex-end; margin-top: 32px;">
            <button type="submit" class="railway-btn-submit">
                Confirm Booking ➔
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const basePrice = @ViewBag.Trip.Price;
            const seatsInput = document.getElementById('seats');
            const totalDisplay = document.getElementById('totalPriceDisplay');

            function updatePrice() {
                const currentSeats = parseInt(seatsInput.value) || 0;
                const finalTotal = basePrice * currentSeats;
                totalDisplay.textContent = finalTotal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            seatsInput.addEventListener('input', updatePrice);
            updatePrice();
        });
    </script>
}