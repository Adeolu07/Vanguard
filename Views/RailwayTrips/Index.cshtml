@{
    Layout = "_Layout";
    ViewData["Title"] = "Railway Trips";
}

<div class="trips-header">
    <h2>🚆 Available Railway Trips</h2>
    <div class="trip-filters">
        <select class="filter-select" id="sortFilter">
            <option value="time">Sort by Time</option>
            <option value="price">Sort by Price</option>
        </select>
    </div>
</div>

<div id="trips-container">
    <div class="loading">Loading railway trips...</div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = 1;

        async function loadTrips(page = 1) {
            try {
                // TODO: Replace with actual railway API endpoint
                const response = await fetch(`/api/railway?page=${page}&pageSize=10`);
                const result = await response.json();

                if (result.success && result.data && result.data.length > 0) {
                    displayTrips(result.data);
                    displayPagination(result.pagination);
                } else {
                    document.getElementById('trips-container').innerHTML = '<div class="empty-state"><div class="empty-icon">🚆</div><h3>No railway trips available</h3><p>Check back later for new schedules</p></div>';
                }
            } catch (error) {
                document.getElementById('trips-container').innerHTML = '<div class="empty-state"><div class="empty-icon">⚠️</div><h3>Coming Soon</h3><p>Railway trips will be available shortly</p><a href="/Home/Index" class="btn-book" style="display: inline-block; width: auto; margin-top: 20px;">Go Back</a></div>';
            }
        }

        function displayTrips(trips) {
            let html = '<div class="trip-options">';
            trips.forEach(trip => {
                html += `
                    <div class="trip-card">
                        <div class="trip-icon train">🚆</div>
                        <div class="trip-content">
                            <h3>${trip.from || 'Lagos'} → ${trip.destination || 'Ibadan'}</h3>
                            <div class="trip-details">
                                <div class="trip-detail"><span>Departure</span><span>${new Date(trip.departureTime).toLocaleString()}</span></div>
                                <div class="trip-detail"><span>Train</span><span>${trip.trainNumber || 'Express'}</span></div>
                                <div class="trip-detail"><span>Seats Available</span><span>${trip.availableSeats || 0}/${trip.totalSeats || 0}</span></div>
                            </div>
                            <div class="trip-price">₦${trip.price?.toLocaleString() || '0'}</div>
                            <button class="btn-book" onclick="bookTrip(${trip.id})">Book Now →</button>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            document.getElementById('trips-container').innerHTML = html;
        }

        function displayPagination(pagination) {
            let html = '<div class="pagination">';
            if (pagination.hasPreviousPage) html += `<button onclick="loadTrips(${pagination.pageIndex - 1})">← Previous</button>`;
            html += `<span>Page ${pagination.pageIndex} of ${pagination.totalPages}</span>`;
            if (pagination.hasNextPage) html += `<button onclick="loadTrips(${pagination.pageIndex + 1})">Next →</button>`;
            html += '</div>';
            document.getElementById('trips-container').insertAdjacentHTML('afterend', html);
        }

        function bookTrip(tripId) {
            window.location.href = `/RailwayTrips/Book?tripId=${tripId}`;
        }

        loadTrips();
    </script>
}