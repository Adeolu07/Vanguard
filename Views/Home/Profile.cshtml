@using _Tripfinity.Utilities
@model _Tripfinity.Models.Tables.User
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "My Profile";
    ViewData["ActiveNav"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="profile-page-wrapper">
    <div class="profile-card">
        <div class="profile-avatar-section">
            <div class="profile-avatar-large">
                <span>@Model.FirstName?.Substring(0, 1)@Model.LastName?.Substring(0, 1)</span>
            </div>
            <div class="profile-name-role">
                <h2>@Model.FirstName @Model.LastName</h2>
                <span class="profile-role-badge">@(Model.Role == "Marshal" ? "Marshal" : "Passenger")</span>
            </div>
        </div>

        <div class="profile-details-card">
            <form asp-action="UpdateProfile" method="post" id="profileForm">
                @Html.AntiForgeryToken()

                <div class="profile-details-grid">
                    <div class="detail-field">
                        <label class="field-label">Email Address</label>
                        <input type="email" value="@Model.Email" class="field-input" disabled />
                        <span class="field-hint">Email cannot be changed</span>
                    </div>

                    <div class="detail-field">
                        <label class="field-label" for="FirstName">First Name</label>
                        <input name="FirstName" id="FirstName" value="@Model.FirstName" class="field-input" disabled required />
                    </div>

                    <div class="detail-field">
                        <label class="field-label" for="LastName">Last Name</label>
                        <input name="LastName" id="LastName" value="@Model.LastName" class="field-input" disabled required />
                    </div>

                    <div class="detail-field">
                        <label class="field-label" for="PhoneNumber">Phone Number</label>
                        <input name="PhoneNumber" id="PhoneNumber" value="@Model.PhoneNumber" class="field-input" disabled required />
                    </div>

                    @if (Model.Role == "Marshal")
                    {
                        <div class="detail-field">
                            <label class="field-label">Vehicle Type</label>
                            <input value="@Model.VehicleType" class="field-input" disabled />
                            <span class="field-hint">Vehicle type is set at registration</span>
                        </div>
                        <div class="detail-field">
                            <label class="field-label">Vehicle ID</label>
                            <input value="@Model.VehicleId" class="field-input" disabled />
                        </div>
                        <div class="detail-field">
                            <label class="field-label">License ID</label>
                            <input value="@Model.LicenseId" class="field-input" disabled />
                        </div>
                    }
                </div>
            </form>
        </div>
        
        @if (Model.Role == "Marshal")
                        {
                            var bank = ViewBag.MarshalBankAccount;
                            <div class="bank-account-section">
                                <h3 class="bank-section-title">Payout Account</h3>

                                @if (bank != null)
                                {
                                    <div class="bank-summary">
                                        <div class="bank-row">
                                            <span class="field-label">Account Name</span>
                                            <span class="bank-value">@bank.AccountName</span>
                                        </div>
                                        <div class="bank-row">
                                            <span class="field-label">Account Number</span>
                                            <span class="bank-value">@bank.AccountNumber</span>
                                        </div>
                                        <div class="bank-row">
                                            <span class="field-label">Bank</span>
                                            <span class="bank-value">@bank.BankName</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="field-hint">No payout account linked yet. Add one to receive trip earnings.</p>
                                }

                                <form asp-controller="Home" asp-action="AddBankAccount" method="post" class="bank-account-form" id="bankAccountForm">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" id="marshalFullName" value="@($"{Model.FirstName} {Model.LastName}".Trim())" />

                                    <div class="detail-field">
                                        <label class="field-label" for="accountNumber">Account Number</label>
                                        <input name="accountNumber" id="accountNumber" class="field-input" placeholder="0123456789" maxlength="10" inputmode="numeric" autocomplete="off" />
                                    </div>
                                    <div class="detail-field">
                                        <label class="field-label" for="bankCode">Bank</label>
                                        <select name="bankCode" id="bankCode" class="field-input">
                                            <option value="">-- Select Bank --</option>
                                            @foreach (var bankOption in Banks.All)
                                            {
                                                <option value="@bankOption.Code">@bankOption.Name</option>
                                            }
                                        </select>
                                    </div>

                                    <div id="bankVerifyStatus" class="bank-verify-status" role="status"></div>

                                    <div class="bank-account-actions">
                                        <button type="button" id="verifyBankBtn" class="btn-secondary">Verify Account</button>
                                        <button type="submit" id="saveBankBtn" class="btn-primary" disabled>Save Account</button>
                                    </div>
                                </form>
                            </div>
                        }
        
        <div class="profile-actions">
            <button type="button" id="editBtn" class="btn-primary">Edit Profile</button>
            <button type="submit" id="saveBtn" class="btn-primary" style="display:none;" form="profileForm">Save Changes</button>
            <button type="button" id="cancelBtn" class="btn-secondary" style="display:none;">Cancel</button>
        </div>

        @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">@TempData["Error"]</div>
            }
        </div>

        <a href="/Home/Dashboard" class="back-link">← Back to Dashboard</a>
    </div>

@section Scripts {
    <script src="~/js/profile.js" asp-append-version="true"></script>
}