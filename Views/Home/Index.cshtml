@{
    Layout = "_Layout";
    ViewData["Title"] = "Welcome";
}

<div class="hero-section">
    <div class="hero-content">
        <h1>Smart Transport<br>Made Simple</h1>
        <p>Book bus trips, pay with wallet, travel stress-free. No queues, no cash, no hassle.</p>
        <div class="hero-buttons">
            <a href="/Auth/DecisionSignUp" class="btn-primary">Create Account →</a>
            <a href="/Auth/DecisionLogin" class="btn-secondary">Sign In</a>
        </div>
    </div>
    <div class="hero-stats">
        <div class="stat">
            <span class="stat-number">500+</span>
            <span class="stat-label">Daily Rides</span>
        </div>
        <div class="stat">
            <span class="stat-number">50k+</span>
            <span class="stat-label">Happy Passengers</span>
        </div>
        <div class="stat">
            <span class="stat-number">24/7</span>
            <span class="stat-label">Support</span>
        </div>
    </div>
</div>

<div class="features-section">
    <h2>Why Choose Tripfinity</h2>
    <div class="features-grid">
        <!-- Digital Wallet Integration Link -->
        <a href="/Wallet" class="feature text-decoration-none text-dark" style="display: block; cursor: pointer; transition: transform 0.2s;">
            <div class="feature-icon">👛</div>
            <h3 class="fw-bold">Digital Wallet</h3>
            <p class="text-muted">Fund your wallet and pay instantly. No cash needed.</p>
        </a>
        <div class="feature">
            <div class="feature-icon">🎫</div>
            <h3>QR Tickets</h3>
            <p>Get digital tickets with QR codes. Scan and board.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">💺</div>
            <h3>Seat Hold</h3>
            <p>Hold your seat for 5 minutes while you complete payment.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">🔄</div>
            <h3>Easy Refunds</h3>
            <p>Cancel online and get refunds to your wallet.</p>
        </div>
    </div>
</div>
