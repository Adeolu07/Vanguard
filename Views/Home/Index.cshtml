@{
    ViewData["Title"] = "Welcome";
}

@section Styles
{
    <link rel="stylesheet" href="css/landing.css"/>
}

<div class="main-section">
    <div class="main-content">
        <h1>Smart Transport,<br>Made Simple</h1>
        <p>Book bus trips, pay with wallet, travel stress-free. No queues, no cash, no hassle.</p>
        <div class="decision-buttons">
            <a href="/Auth/DecisionSignUp" class="btn-signup">Create Account →</a>
            <a href="/Auth/DecisionLogin" class="btn-login">Sign In</a>
        </div>
    </div>
    <div class="hero-stats">
        <div class="stat">
            <span class="stat-number">500+ Daily rides</span>
        </div>
        <div class="stat">
            <span class="stat-number">50k+ Happy Passengers</span>
        </div>
        <div class="stat">
            <span class="stat-number">24/7 Support</span>
        </div>
    </div>
</div>

<div class="secondary-section">
    <h2>Why Choose Tripfinity</h2>
    <div class="features-grid">
        <div class="feature">
            <div class="feature-icon">👛</div>
            <h3>Digital Wallet</h3>
            <p>Fund your wallet and pay instantly. No cash needed.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">🎫</div>
            <h3>QR Tickets</h3>
            <p>Get digital tickets with QR codes. Scan and board.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">🔄</div>
            <h3>Easy Refunds</h3>
            <p>Cancel online and get refunds to your wallet.</p>
        </div>
    </div>
</div>

