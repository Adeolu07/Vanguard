@model _Tripfinity.Models.ViewModels.TransactionsViewModel?
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Wallet";
    ViewData["ActiveNav"] = "Wallet";
}

@section Styles {
    <link rel="stylesheet" href="~/css/wallet.css" />
    <style>
        .fund-note { color: #64748b; margin-bottom: 12px; }
        .fund-modal-overlay { position: fixed; inset: 0; background: rgba(15,23,42,.55); display: none; align-items: center; justify-content: center; z-index: 100; }
        .fund-modal-overlay.active { display: flex; }
        .fund-modal { background: #fff; border-radius: 12px; padding: 24px; width: min(420px, 90vw); position: relative; }
        .fund-modal h3 { margin-bottom: 4px; }
        .fund-modal-sub { color: #64748b; font-size: .85rem; margin-bottom: 16px; }
        .fund-modal-close { position: absolute; top: 12px; right: 16px; background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #64748b; }
        .fund-account-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #e2e8f0; font-size: 1.05rem; }
        .fund-label { color: #64748b; width: 130px; flex-shrink: 0; }
        .fund-value { font-weight: 600; letter-spacing: .05em; }
        .btn-copy { margin-left: auto; background: #eef2ff; color: #3730a3; border: none; border-radius: 6px; padding: 6px 12px; cursor: pointer; font-weight: 600; }
        .fund-modal-disclaimer { margin-top: 16px; font-size: .75rem; color: #94a3b8; }
    </style>
}
@section Scripts {
    <script src="~/js/site.js"></script>
}

<section class="welcome-section">
    <span class="sub-brand">FINANCE</span>
    <h1>My Wallet</h1>
    <p>Check your balance and add funds.</p>
</section>

<section class="balance-banner">
    <span class="balance-label">CURRENT BALANCE</span>
    <div class="balance-wrapper">
        <h1 id="walletBalance">₦@Model?.Balance.ToString("N2")</h1>
    </div>
    <div class="status-badge">
        <span class="dot"></span> Active & Secure
    </div>
</section>

<div class="fund-wallet">
    <h4>Add Funds</h4>
    <p class="fund-note">Fund your wallet via bank transfer. Your wallet is credited automatically once payment reflects.</p>
    <button id="fundButton" class="btn-fund" type="button">Fund Wallet</button>
    <input type="hidden" id="walletId" value="@ViewBag.WalletId" />
    <div id="fundMessage" class="fund-message"></div>
</div>

<div class="fund-modal-overlay" id="fundModalOverlay">
    <div class="fund-modal">
        <button class="fund-modal-close" id="fundModalClose" type="button" aria-label="Close">&times;</button>
        <h3>Fund Your Wallet</h3>
        <p class="fund-modal-sub">Transfer to the account below to top up your wallet.</p>
        <div class="fund-account-row">
            <span class="fund-label">Account Number</span>
            <span class="fund-value" id="modalAccountNumber">—</span>
            <button class="btn-copy" id="copyAccountBtn" type="button">Copy</button>
        </div>
        <div class="fund-account-row">
            <span class="fund-label">Bank</span>
            <span class="fund-value" id="modalBankName">—</span>
        </div>
        <div class="fund-account-row">
            <span class="fund-label">Account Name</span>
            <span class="fund-value" id="modalAccountName">—</span>
        </div>
        <p class="fund-modal-disclaimer">Use your unique account number as the reference when sending funds.</p>
    </div>
</div>


<section class="transaction-history-section">
    <div class="section-header">
        <h3>Transaction History</h3>
        <span class="page-indicator">Page @Model?.CurrentPage of @Model?.TotalPages</span>
    </div>

    @if (!Model!.Transactions!.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📭</div>
            <p>No transactions yet</p>
        </div>
    }
    else
    {
        <div class="transaction-list">
            @foreach (var txn in Model.Transactions!)
            {
                var typeClass = txn.TranType!.ToLower();
                var isCredit = typeClass == "credit";
                <div class="txn-row"
                     data-type="@txn.TranType"
                     data-amount="@Math.Abs(txn.Amount).ToString("N2")"
                     data-description="@txn.Description"
                     data-transaction-id="@txn.TransactionId"
                     data-session-id="@txn.SessionId">
                    <div class="txn-row-left">
                        <span class="txn-icon @typeClass">
                            @if (isCredit)
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
                            }
                        </span>
                        <span class="txn-date">@txn.TranType Transaction</span>
                    </div>
                    <div class="txn-row-right">
                        <span class="txn-amount @typeClass">@(isCredit ? "+" : "–")₦@Math.Abs(txn.Amount).ToString("N2")</span>
                        <svg class="txn-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 6 15 12 9 18"></polyline></svg>
                    </div>
                </div>
            }
        </div>

        <div class="pagination-bar">
            @if (Model.HasPrevious)
            {
                <a href="?page=@(Model.CurrentPage - 1)" class="page-btn prev-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    Previous
                </a>
            }
            else
            {
                <span class="page-btn disabled">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    Previous
                </span>
            }
            @if (Model.HasNext)
            {
                <a href="?page=@(Model.CurrentPage + 1)" class="page-btn next-btn">
                    Next
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            }
            else
            {
                <span class="page-btn disabled">
                    Next
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </span>
            }
        </div>
    }
</section>

<!-- Receipt Modal -->
<div class="receipt-overlay" id="receiptOverlay">
    <div class="receipt-modal">
        <button class="receipt-close" id="receiptClose" type="button" aria-label="Close">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>

        <div class="receipt-brand">TRIPFINITY</div>
        <div class="receipt-header">
            <div class="receipt-status-icon" id="receiptStatusIcon"></div>
            <h2 id="receiptAmount"></h2>
            <span id="receiptTypeLabel"></span>
        </div>

        <div class="receipt-body">
            <div class="receipt-row">
                <span class="receipt-label">Description</span>
                <span class="receipt-value" id="receiptDescription"></span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">Transaction ID</span>
                <span class="receipt-value" id="receiptTransactionId"></span>
            </div>
            <div class="receipt-row" id="receiptSessionRow">
                <span class="receipt-label">Session ID</span>
                <span class="receipt-value" id="receiptSessionId"></span>
            </div>
        </div>

        <div class="receipt-actions">
            <button class="btn-print" id="receiptPrintBtn" type="button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                Print Receipt
            </button>
        </div>
    </div>
</div>

<!-- Hidden printable receipt, populated on print -->
<div id="printableReceipt">
    <h2 style="text-align:center; letter-spacing:1.5px; color:#3b82f6; font-size:12px; margin-bottom:24px;">TRIPFINITY</h2>
    <h1 style="text-align:center; margin-bottom:4px;" id="printAmount"></h1>
    <p style="text-align:center; color:#64748b; margin-bottom:24px;" id="printTypeLabel"></p>
    <table style="width:100%; border-top:1px dashed #cbd5e1; padding-top:12px; border-collapse:collapse;">
        <tr><td style="padding:6px 0; color:#94a3b8;">Description</td><td style="padding:6px 0; text-align:right; font-weight:600;" id="printDescription"></td></tr>
        <tr><td style="padding:6px 0; color:#94a3b8;">Transaction ID</td><td style="padding:6px 0; text-align:right; font-weight:600;" id="printTransactionId"></td></tr>
        <tr id="printSessionRow"><td style="padding:6px 0; color:#94a3b8;">Session ID</td><td style="padding:6px 0; text-align:right; font-weight:600;" id="printSessionId"></td></tr>
    </table>
</div>

