@{
    Layout = "_Layout";
    ViewData["Title"] = "Welcome";
}

<div class="hero-section">
    <div class="hero-content">
        <h1>Smart Transport<br>Made Simple</h1>
        <p>Book bus trips, pay with wallet, travel stress-free. No queues, no cash, no hassle.</p>
        <div class="hero-buttons">
            <a href="/Auth/SignUp" class="btn-primary">Get Started →</a>
            <a href="/Auth/SignIn" class="btn-secondary">Sign In</a>
        </div>
    </div>
    <div class="hero-stats">
        <div class="stat">
            <span class="stat-number">500+</span>
            <span class="stat-label">Daily Rides</span>
        </div>
        <div class="stat">
            <span class="stat-number">50k+</span>
            <span class="stat-label">Happy Passengers</span>
        </div>
        <div class="stat">
            <span class="stat-number">24/7</span>
            <span class="stat-label">Support</span>
        </div>
    </div>
</div>

<div class="features-section">
    <h2>Why Choose Tripfinity</h2>
    <div class="features-grid">
        <div class="feature">
            <div class="feature-icon">👛</div>
            <h3>Digital Wallet</h3>
            <p>Fund your wallet and pay instantly. No cash needed.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">🎫</div>
            <h3>QR Tickets</h3>
            <p>Get digital tickets with QR codes. Scan and board.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">💺</div>
            <h3>Seat Hold</h3>
            <p>Hold your seat for 5 minutes while you complete payment.</p>
        </div>
        <div class="feature">
            <div class="feature-icon">🔄</div>
            <h3>Easy Refunds</h3>
            <p>Cancel online and get refunds to your wallet.</p>
        </div>
    </div>
</div>

<div class="cta-section">
    <h2>Ready to Ride?</h2>
    <p>Join thousands of passengers already using Tripfinity</p>
    <a href="/Auth/SignUp" class="btn-primary">Create Account →</a>
</div>