@model _Tripfinity.Models.Data.Requests.CreateTaxiTripRequest
@{
    Layout = "_MarshalLayout";
    ViewData["Title"] = "Create Taxi Trip";
}
@section Styles {
    <link rel="stylesheet" href="~/css/marshal-portal.css" />
}

<div class="marshal-create">
    <header class="page-header">
        <h2>Create Taxi Trip</h2>
    </header>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="CreateTaxi" method="post" class="create-form">
        <div class="form-group">
            <label asp-for="PickupLocation"></label>
            <input asp-for="PickupLocation" placeholder="Pickup location" />
            <span asp-validation-for="PickupLocation" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DropoffLocation"></label>
            <input asp-for="DropoffLocation" placeholder="Dropoff location" />
            <span asp-validation-for="DropoffLocation" class="text-danger"></span>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Price">Price (₦)</label>
                <input asp-for="Price" type="number" step="0.01" placeholder="0.00" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NumberOfPassengers">Max Passengers</label>
                <input asp-for="NumberOfPassengers" type="number" placeholder="1-5" />
                <span asp-validation-for="NumberOfPassengers" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="PickupTime"></label>
            <input asp-for="PickupTime" type="datetime-local" step="60" />
            <span asp-validation-for="PickupTime" class="text-danger"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-primary">Create Trip</button>
            <a href="/marshal" class="btn-secondary">Cancel</a>
        </div>
    </form>
</div>