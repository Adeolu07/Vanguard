@model _Tripfinity.Models.Data.Requests.CreateTaxiTripRequest
@{
    ViewData["Title"] = "Create Taxi Trip";
    Layout = "_MarshalLayout";
}

<div class="container mt-4">
    <h2>Create Taxi Trip</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="CreateTaxi" method="post" class="mt-3">
        <div class="mb-3">
            <label asp-for="PickupLocation" class="form-label"></label>
            <input asp-for="PickupLocation" class="form-control" />
            <span asp-validation-for="PickupLocation" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DropoffLocation" class="form-label"></label>
            <input asp-for="DropoffLocation" class="form-control" />
            <span asp-validation-for="DropoffLocation" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NumberOfPassengers" class="form-label">Max Passengers</label>
            <input asp-for="NumberOfPassengers" type="number" class="form-control" />
            <span asp-validation-for="NumberOfPassengers" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PickupTime" class="form-label"></label>
            <input asp-for="PickupTime" type="datetime-local" class="form-control" />
            <span asp-validation-for="PickupTime" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Create Trip</button>
        <a href="/marshal" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}