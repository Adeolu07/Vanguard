@model IEnumerable<object>
@using _Tripfinity.Models.Tables
@using _Tripfinity.Models.Enums
@{
    ViewData["Title"] = "My Trips";
    ViewData["ActiveNav"] = "My Trips";
    var vehicleType = ViewBag.VehicleType as string ?? "";
    Layout = "_MarshalLayout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/marshal-portal.css" />
}

<div class="marshal-trips">
    <header class="page-header">
        <h2>My @vehicleType Trips</h2>
        <a href="/marshal/create/@vehicleType.ToLower()" class="btn-primary">+ New Trip</a>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">🗺️</div>
            <h3>No trips yet</h3>
            <p>Create your first trip to get started.</p>
            <a href="/marshal/create/@vehicleType.ToLower()" class="btn-primary">Create Trip</a>
        </div>
    }
    else
    {
        <div class="trips-grid">
            @if (string.Equals(vehicleType, "Taxi", StringComparison.OrdinalIgnoreCase))
            {
                @foreach (var trip in Model.Cast<TaxiTrip>())
                {
                    <a href="/marshal/trips/@trip.Id" class="trip-card">
                        <div class="trip-route">@trip.PickupLocation <span>→</span> @trip.DropoffLocation</div>
                        <div class="trip-meta">
                            <span>🕒 @trip.PickupTime.ToString("g")</span>
                            <span>👥 @trip.MaxPassengers max</span>
                            <span>₦@trip.Price.ToString("N0")</span>
                        </div>
                        <div class="trip-status @trip.Status.ToString().ToLower()">
                            @trip.Status
                        </div>
                        @if (trip.Status == TripStatus.Inactive)
                        {
                            <form asp-action="CancelTrip" method="post" class="cancel-form" onclick="event.stopPropagation();">
                                <input type="hidden" name="transportType" value="Taxi" />
                                <input type="hidden" name="tripId" value="@trip.Id" />
                                <input type="text" name="reason" placeholder="Reason" required />
                                <button type="submit" class="btn-danger">Cancel</button>
                            </form>
                        }
                    </a>
                }
            }
            else
            {
                @foreach (dynamic trip in Model)
                {
                    <a href="/marshal/trips/@trip.Id" class="trip-card">
                        <div class="trip-route">@trip.From <span>→</span> @trip.Destination</div>
                        <div class="trip-meta">
                            <span>🕒 @trip.DepartureTime.ToString("g")</span>
                            <span>💺 @trip.AvailableSeats / @trip.TotalSeats</span>
                            <span>₦@trip.Price.ToString("N0")</span>
                        </div>
                        <div class="trip-status @trip.Status.ToString().ToLower()">
                            @trip.Status
                        </div>
                        @if (trip.Status == TripStatus.Inactive)
                        {
                            <form asp-action="CancelTrip" method="post" class="cancel-form" onclick="event.stopPropagation();">
                                <input type="hidden" name="transportType" value="@vehicleType" />
                                <input type="hidden" name="tripId" value="@trip.Id" />
                                <input type="text" name="reason" placeholder="Reason" required />
                                <button type="submit" class="btn-danger">Cancel</button>
                            </form>
                        }
                    </a>
                }
            }
        </div>
    }
</div>