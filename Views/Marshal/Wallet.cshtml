@model _Tripfinity.Models.ViewModels.MarshalWalletViewModel?
@{
    Layout = "_MarshalLayout";
    ViewData["Title"] = "My Wallet";
    ViewData["ActiveNav"] = "Wallet";
}

@section Styles {
    <link rel="stylesheet" href="~/css/wallet.css" />
    <link rel="stylesheet" href="~/css/marshal-wallet.css" />
}

<div class="content">
    <!-- Balance card -->
    <div class="card">
        <div class="balance-label">AVAILABLE BALANCE</div>
        <div class="balance-amount">₦@((Model?.Balance ?? 0).ToString("N2"))</div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="cashOutBtn">Cash Out</button>
        </div>
        <div id="cashoutStatus" class="enquiry-result"></div>
        <span id="walletCustomerId" hidden>@Model?.WalletId</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (Model != null)
    {
        <div class="card" id="history">
            <div class="section-header">
                <h3>Transaction History</h3>
                <span class="page-indicator">Page @Model.CurrentPage of @Model.TotalPages</span>
            </div>

            @if (!Model.Transactions!.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">📭</div>
                    <p>No transactions yet</p>
                </div>
            }
            else
            {
                <div class="transaction-list">
                    @foreach (var txn in Model.Transactions!)
                    {
                        var typeClass = txn.TranType?.ToLower();
                        var isCredit = typeClass == "credit";
                        <div class="txn-row"
                             data-type="@txn.TranType"
                             data-amount="@Math.Abs(txn.Amount).ToString("N2")"
                             data-description="@txn.Description"
                             data-transaction-id="@txn.TransactionId"
                             data-session-id="@(txn.SessionId ?? "")"
                             role="button"
                             tabindex="0">
                            <div class="txn-row-left">
                                <span class="txn-icon @typeClass">
                                    @if (isCredit)
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
                                    }
                                    else
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
                                    }
                                </span>
                                <div class="txn-info">
                                    <div class="txn-description">@txn.Description</div>
                                    <div class="txn-id">@txn.TransactionId</div>
                                </div>
                            </div>
                            <div class="txn-amount @typeClass">
                                @(isCredit ? "+" : "-")₦@Math.Abs(txn.Amount).ToString("N2")
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- Transaction detail modal -->
    <div class="modal-overlay" id="txnModal">
        <div class="modal-box">
            <h3>Transaction Details</h3>
            <div class="detail-row"><span class="detail-label">Type</span><span class="detail-value" id="mType"></span></div>
            <div class="detail-row"><span class="detail-label">Amount</span><span class="detail-value" id="mAmount"></span></div>
            <div class="detail-row"><span class="detail-label">Description</span><span class="detail-value" id="mDescription"></span></div>
            <div class="detail-row"><span class="detail-label">Transaction ID</span><span class="detail-value" id="mTransactionId"></span></div>
            <div class="detail-row"><span class="detail-label">Session ID</span><span class="detail-value" id="mSessionId"></span></div>
            <div class="btn-row modal-actions">
                <button type="button" class="btn btn-secondary" data-close-modal="txnModal">Close</button>
            </div>
        </div>
    </div>

    <!-- Cash out modal -->
    <div class="modal-overlay" id="cashoutModal">
        <div class="modal-box">
            <h3>Cash Out</h3>
            <div class="detail-row"><span class="detail-label">Account Name</span><span class="detail-value" id="cAccountName"></span></div>
            <div class="detail-row"><span class="detail-label">Account Number</span><span class="detail-value" id="cAccountNumber"></span></div>
            <div class="detail-row"><span class="detail-label">Bank</span><span class="detail-value" id="cBankName"></span></div>
            <div class="form-row">
                <div class="field">
                    <label for="cashoutAmount">AMOUNT (₦)</label>
                    <input id="cashoutAmount" type="number" min="1" step="1" placeholder="0.00" />
                </div>
            </div>
            <div id="cashoutMessage" class="enquiry-result"></div>
            <div class="btn-row modal-actions">
                <button type="button" class="btn btn-secondary" data-close-modal="cashoutModal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmCashoutBtn">Cash Out</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/marshal-wallet.js"></script>
}