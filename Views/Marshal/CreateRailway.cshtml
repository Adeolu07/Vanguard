@model _Tripfinity.Models.Data.Requests.CreateRailwayTripRequest
@{
    Layout = "_MarshalLayout";
    ViewData["Title"] = "Create Railway Trip";
}
@section Styles {
    <link rel="stylesheet" href="~/css/marshal-portal.css" />
}

<div class="marshal-create">
    <header class="page-header">
        <h2>Create Railway Trip</h2>
    </header>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="CreateRailway" method="post" class="create-form">
        <div class="form-group">
            <label asp-for="From"></label>
            <input asp-for="From" placeholder="Departure city" />
            <span asp-validation-for="From" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Destination"></label>
            <input asp-for="Destination" placeholder="Arrival city" />
            <span asp-validation-for="Destination" class="text-danger"></span>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Price">Price (₦)</label>
                <input asp-for="Price" type="number" step="0.01" placeholder="0.00" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalSeats"></label>
                <input asp-for="TotalSeats" type="number" placeholder="Total" />
                <span asp-validation-for="TotalSeats" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AvailableSeats"></label>
                <input asp-for="AvailableSeats" type="number" placeholder="Available" />
                <span asp-validation-for="AvailableSeats" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="DepartureTime"></label>
            <input asp-for="DepartureTime" type="datetime-local" step="60"/>
            <span asp-validation-for="DepartureTime" class="text-danger"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-primary">Create Trip</button>
            <a href="/marshal" class="btn-secondary">Cancel</a>
        </div>
    </form>
</div>

