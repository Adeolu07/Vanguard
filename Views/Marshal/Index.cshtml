@{
    Layout = "_Layout";
    ViewData["Title"] = "Marshal Dashboard";
}
@section Styles {
    <link rel="stylesheet" href="~/css/marshal-portal.css" />
}

<div class="marshal-dashboard">
    <header class="dashboard-header">
        <div class="header-greeting">
            <h1>Welcome back, @ViewBag.FirstName</h1>
            <p>@ViewBag.VehicleType — @ViewBag.VehicleId</p>
        </div>
        <a href="/Auth/Logout" class="btn-signout">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
            Sign Out
        </a>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="dashboard-actions">
        <a href="/marshal/trips" class="action-card">
            <div class="card-icon">📋</div>
            <h3>My Trips</h3>
            <p>View & manage your scheduled trips</p>
        </a>
        <a href="/marshal/scan" class="action-card">
            <div class="card-icon">📱</div>
            <h3>Scan Ticket</h3>
            <p>Validate passenger QR codes</p>
        </a>
        <a href="/marshal/create/@ViewBag.VehicleType.ToString().ToLower()" class="action-card">
            <div class="card-icon">➕</div>
            <h3>Create Trip</h3>
            <p>Add a new @ViewBag.VehicleType trip</p>
        </a>
    </div>
</div>