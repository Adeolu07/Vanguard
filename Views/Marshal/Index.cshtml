@{
    ViewData["Title"] = "Marshal Dashboard";
    ViewData["ActiveNav"] = "Dashboard";
    Layout = "_MarshalLayout";
}

@section Styles{
    <link rel="stylesheet" href="css/marshal-portal.css"/>
}
<div class="marshal-dashboard">
    <header class="dashboard-header">
        <div class="header-greeting">
            <h1>Welcome back, @ViewBag.FirstName</h1>
            <p>@ViewBag.VehicleType — @ViewBag.VehicleId</p>
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-danger">@TempData["Error"]</div>
    }

    <div class="action-grid">
        <a href="/marshal/trips" class="action-card">
            <div class="card-icon">📋</div>
            <h3>My Trips</h3>
            <p>View & manage your scheduled trips</p>
        </a>
        <a href="/marshal/scan" class="action-card">
            <div class="card-icon">📱</div>
            <h3>Scan Ticket</h3>
            <p>Validate passenger QR codes</p>
        </a>
        <a href="/marshal/create/@ViewBag.VehicleType.ToString().ToLower()" class="action-card">
            <div class="card-icon">➕</div>
            <h3>Create Trip</h3>
            <p>Schedule a new @ViewBag.VehicleType trip</p>
        </a>
        <a href="/marshal/wallet" class="action-card">
            <div class="card-icon">💰</div>
            <h3>Wallet</h3>
            <p>View balance & cash out</p>
        </a>
    </div>
</div>