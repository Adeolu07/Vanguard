@{
    ViewData["Title"] = "Marshal Dashboard";
}

<div class="container mt-4">
    <h2>Welcome, @ViewBag.FirstName</h2>
    <p class="text-muted">Vehicle: @ViewBag.VehicleType — @ViewBag.VehicleId</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row mt-4 g-3">
        <div class="col-md-4">
            <a href="/marshal/trips" class="text-decoration-none">
                <div class="card text-white bg-primary">
                    <div class="card-body text-center">
                        <h5 class="card-title">My Trips</h5>
                        <p class="card-text">View & manage your trips</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/marshal/scan" class="text-decoration-none">
                <div class="card text-white bg-success">
                    <div class="card-body text-center">
                        <h5 class="card-title">Scan Ticket</h5>
                        <p class="card-text">Validate passenger QR</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/marshal/create/@ViewBag.VehicleType.ToString().ToLower()" class="text-decoration-none">
                <div class="card text-white bg-warning">
                    <div class="card-body text-center">
                        <h5 class="card-title">Create Trip</h5>
                        <p class="card-text">Add a new @ViewBag.VehicleType trip</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>