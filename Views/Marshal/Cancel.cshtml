@{
ViewData["Title"] = "Cancel a Trip";
Layout = "_MarshalLayout";
}

@section Styles {
<link rel="stylesheet" href="~/css/marshal-cancel.css" />
}

<div class="cancel-page" data-vehicle-type="@ViewBag.VehicleType">
    <h2>Cancel Trip (@ViewBag.VehicleType)</h2>

    @if (ViewBag.Trips != null && ViewBag.Trips.Count > 0)
    {
    <table class="cancel-table">
        <thead>
        <tr>
            <th>Trip ID</th>
            <th>From</th>
            <th>To</th>
            <th>Departure</th>
            <th>Action</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var trip in ViewBag.Trips)
        {
        <tr>
            <td>@trip.Id</td>
            <td>@trip.From</td>
            <td>@trip.Destination</td>
            <td>@trip.DepartureTime.ToString("g")</td>
            <td>
                <button class="btn-cancel" data-trip-id="@trip.Id">Cancel</button>
            </td>
        </tr>
        }
        </tbody>
    </table>
    }
    else
    {
    <p class="empty-msg">No active trips to cancel.</p>
    }
</div>

@section Scripts {
<script src="~/js/marshal-cancel.js"></script>
}