@model _Tripfinity.Models.Data.Requests.CreateBusTripRequest
@{
    ViewData["Title"] = "Create Bus Trip";
}

<div class="container mt-4">
    <h2>Create Bus Trip</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="CreateBus" method="post" class="mt-3">
        <div class="mb-3">
            <label asp-for="From" class="form-label"></label>
            <input asp-for="From" class="form-control" />
            <span asp-validation-for="From" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Destination" class="form-label"></label>
            <input asp-for="Destination" class="form-control" />
            <span asp-validation-for="Destination" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="TotalSeats" class="form-label"></label>
                <input asp-for="TotalSeats" type="number" class="form-control" />
                <span asp-validation-for="TotalSeats" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="AvailableSeats" class="form-label"></label>
                <input asp-for="AvailableSeats" type="number" class="form-control" />
                <span asp-validation-for="AvailableSeats" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="DepartureTime" class="form-label"></label>
            <input asp-for="DepartureTime" type="datetime-local" class="form-control" />
            <span asp-validation-for="DepartureTime" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Create Trip</button>
        <a href="/marshal" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}