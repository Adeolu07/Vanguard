@{
  ViewData["Title"] = "Scan & Validate Ticket";
  ViewData["ActiveNav"] = "Scan";
  Layout = "_MarshalLayout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/marshal-portal.css" />
}

<div class="marshal-scan">
    <header class="page-header">
        <h2>Scan Ticket</h2>
        <p>Enter the QR token from the passenger's ticket to validate it.</p>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Scan" method="post" class="scan-form">
        <input type="text" name="qrToken" placeholder="Enter QR token..." autofocus required />
        <button type="submit" class="btn-primary">Validate</button>
    </form>

    @if (ViewBag.ValidatedTicket != null)
    {
        var ticket = (_Tripfinity.Models.Tables.Ticket)ViewBag.ValidatedTicket;
        <div class="validated-ticket">
            <div class="ticket-confirmed">✓ Ticket Validated</div>
            <div class="ticket-details">
                <div><strong>Reference:</strong> @ticket.TicketReference</div>
                <div><strong>Transport:</strong> @ticket.TransportType</div>
                <div><strong>Trip Time:</strong> @ticket.TripTime.ToString("g")</div>
                <div><strong>Status:</strong> @ticket.Status</div>
                @if (ticket.ValidatedAt.HasValue)
                {
                    <div><strong>Validated At:</strong> @ticket.ValidatedAt.Value.ToString("g")</div>
                }
            </div>
        </div>
    }
</div>