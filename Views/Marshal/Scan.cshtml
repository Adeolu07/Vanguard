@using _Tripfinity.Models.Tables
@model string
@{
    ViewData["Title"] = "Scan & Validate Ticket";
}

<div class="container mt-4">
    <h2>Scan Ticket</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Scan" method="post" class="mb-4">
        <div class="input-group">
            <input type="text" name="qrToken" class="form-control" placeholder="Scan or type QR token..." autofocus />
            <button type="submit" class="btn btn-primary">Validate</button>
        </div>
    </form>

    @if (ViewBag.ValidatedTicket != null)
    {
        var ticket = (Ticket)ViewBag.ValidatedTicket;
        <div class="card">
            <div class="card-header bg-success text-white">
                Ticket Validated
            </div>
            <div class="card-body">
                <p><strong>Reference:</strong> @ticket.TicketReference</p>
                <p><strong>Transport:</strong> @ticket.TransportType</p>
                <p><strong>Trip Time:</strong> @ticket.TripTime.ToString("g")</p>
                <p><strong>Status:</strong> @ticket.Status</p>
                <p><strong>Validated At:</strong> @ticket.ValidatedAt?.ToString("g")</p>
            </div>
        </div>
    }
</div>