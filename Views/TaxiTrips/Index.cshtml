@{
@model _Tripfinity.Views.PaginatedList<_Tripfinity.Models.Tables.TaxiTrip>
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Taxi Trips";
}
@section Styles {
    <link rel="stylesheet" href="~/css/bus-trips.css" />
}

<section class="page-title-section">
    <div class="breadcrumbs">Passenger Dashboard > Book a Taxi</div>
    <h1>Available Taxi Rides</h1>
    <p>Real-time taxi availability.</p>
</section>

<div id="trips-container">
    @if (!Model.Any())
    {
        <p>No rides available right now.</p>
    }
    else
    {
        <div class="trip-options">
            @foreach (var trip in Model)
            {
                var formattedDate = trip.PickupTime.ToString("MM/dd/yyyy");
                var formattedTime = trip.PickupTime.ToString("hh:mm tt");
                <div class="trip-card">
                    <div class="trip-card-icon">🚕</div>
                    <div class="route-display">
                        <h2>@trip.PickupLocation</h2>
                        <span class="route-arrow">→</span>
                        <h2>@trip.DropoffLocation</h2>
                    </div>
                    <div class="meta-grid">
                        <div class="meta-item">
                            <span class="meta-label">Pickup</span>
                            <span class="meta-value">@formattedDate<br><span style="color:var(--text-muted); font-weight:400;">@formattedTime</span></span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Price</span>
                            <span class="meta-value">₦@trip.Price.ToString("N0")</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Passengers</span>
                            <span class="meta-value">@trip.MaxPassengers max</span>
                        </div>
                    </div>
                    <a href="/Trips/Taxi/@trip.Id/Book" class="btn-book-action">Book Now ></a>
                </div>
            }
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @if (Model.HasPreviousPage)
        {
            <a href="/Trips/Taxi?page=@(Model.PageIndex - 1)" class="page-btn">Previous</a>
        }
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            if (i == Model.PageIndex)
            {
                <span class="page-num active">@i</span>
            }
            else
            {
                <a href="/Trips/Taxi?page=@i" class="page-num">@i</a>
            }
        }
        @if (Model.HasNextPage)
        {
            <a href="/Trips/Taxi?page=@(Model.PageIndex + 1)" class="page-btn">Next ></a>
        }
    </div>
}