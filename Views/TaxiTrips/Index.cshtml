@{
    Layout = "_Layout";
    ViewData["Title"] = "Taxi Trips";
}

<link rel="stylesheet" href="~/css/trips.css"/>

<div class="trips-header">
    <h2>🚕 Available Taxi Trips</h2>
    <div class="trip-filters">
        <select class="filter-select" id="sortFilter">
            <option value="time">Sort by Time</option>
            <option value="price">Sort by Price</option>
        </select>
    </div>
</div>

<div id="trips-container">
    <div class="loading">Loading taxi trips...</div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = 1;
        let currentSort = "time";

        async function loadTrips(page = 1) {
            try {
                const response = await fetch(`/api/taxitrips?page=${page}&pageSize=10&sort=${currentSort}`);
                const result = await response.json();

                if (result.success && result.data && result.data.length > 0) {
                    displayTrips(result.data);
                    displayPagination(result.pagination);
                } else {
                    document.getElementById('trips-container').innerHTML = '<div class="empty-state"><div class="empty-icon">🚕</div><h3>No taxi trips available</h3><p>Check back later for available rides</p></div>';
                }
            } catch (error) {
                document.getElementById('trips-container').innerHTML = '<div class="empty-state"><div class="empty-icon">🚕</div><h3>Coming Soon</h3><p>Taxi trips will be available shortly</p><a href="/Home/Index" class="btn-book" style="display: inline-block; width: auto; margin-top: 20px;">Go Back</a></div>';
            }
        }

        function displayTrips(trips) {
            let html = '<div class="trip-options">';
            trips.forEach(trip => {
                html += `
                    <div class="trip-card">
                        <div class="trip-icon taxi">🚕</div>
                        <div class="trip-content">
                            <h3>${trip.pickupLocation || 'Pickup'} → ${trip.dropoffLocation || 'Dropoff'}</h3>
                            <div class="trip-details">
                                <div class="trip-detail"><span>Pickup Time</span><span>${new Date(trip.pickupTime).toLocaleString()}</span></div>
                                <div class="trip-detail"><span>Vehicle</span><span>${trip.vehicleType || 'Standard'}</span></div>
                                <div class="trip-detail"><span>Capacity</span><span>${trip.maxPassengers || 4} passengers</span></div>
                            </div>
                            <div class="trip-price">₦${trip.price?.toLocaleString() || '0'}</div>
                            <button class="btn-book" onclick="bookTrip(${trip.id})">Book Now →</button>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            document.getElementById('trips-container').innerHTML = html;
        }

        function displayPagination(pagination) {
            // Remove existing pagination
            const existingPagination = document.querySelector('.pagination');
            if (existingPagination) existingPagination.remove();

            let html = '<div class="pagination">';
            if (pagination.hasPreviousPage) html += `<button onclick="loadTrips(${pagination.pageIndex - 1})">← Previous</button>`;
            html += `<span>Page ${pagination.pageIndex} of ${pagination.totalPages}</span>`;
            if (pagination.hasNextPage) html += `<button onclick="loadTrips(${pagination.pageIndex + 1})">Next →</button>`;
            html += '</div>';
            document.getElementById('trips-container').insertAdjacentHTML('afterend', html);
        }

        function bookTrip(tripId) {
            window.location.href = `/RailwayTrips/Book?tripId=${tripId}`;
        }

        // Sort filter handler
        document.getElementById('sortFilter').addEventListener('change', (e) => {
            currentSort = e.target.value;
            loadTrips(1);
        });

        loadTrips();
    </script>
}