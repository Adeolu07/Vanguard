@using _Tripfinity.Services
@model _Tripfinity.Models.Tables.Booking
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Booking Confirmed";
}
@section Styles {
    <link rel="stylesheet" href="~/css/confirmation.css" />
}

<header class="top-header">
    <h2>Confirmation</h2>
    <a href="/Auth/Logout" class="btn-signout">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
        Sign Out
    </a>
</header>

<div class="confirmation-card">
    <div class="confirmation-icon">✅</div>
    <h2>Booking Confirmed!</h2>
    <div class="confirmation-details">
        <p><strong>Booking ID:</strong> #@Model.Id</p>
        <p><strong>Transport:</strong> @Model.TransportType</p>
        @if (Model.TransportType == TransportType.Bus && Model.BusTrip != null)
        {
            <p><strong>From:</strong> @Model.BusTrip.From → <strong>@Model.BusTrip.Destination</strong></p>
            <p><strong>Departure:</strong> @Model.BusTrip.DepartureTime</p>
        }
        else if (Model.TransportType == TransportType.Taxi && Model.TaxiTrip != null)
        {
            <p><strong>Pickup:</strong> @Model.TaxiTrip.PickupLocation → <strong>@Model.TaxiTrip.DropoffLocation</strong></p>
            <p><strong>Time:</strong> @Model.TaxiTrip.PickupTime</p>
        }
        else if (Model.TransportType == TransportType.Railway && Model.RailwayTrip != null)
        {
            <p><strong>From:</strong> @Model.RailwayTrip.From → <strong>@Model.RailwayTrip.Destination</strong></p>
            <p><strong>Departure:</strong> @Model.RailwayTrip.DepartureTime</p>
            <p><strong>Class:</strong> @Model.RailwayTrip.TrainClass</p>
        }
        <p><strong>Seats:</strong> @Model.NumberOfSeats</p>
        <p><strong>Total Amount:</strong> ₦@Model.TotalAmount.ToString("N0")</p>
        <p><strong>Status:</strong> @Model.Status</p>
    </div>
    <a href="/Home/Dashboard" class="btn-back">Go to Dashboard</a>
</div>