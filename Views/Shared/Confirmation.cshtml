@model Booking

@{
    Layout = "_Layout";
    ViewData["Title"] = "Booking Confirmation";
}

<div class="confirmation-container">
    <div class="success-icon">✅</div>
    <h2>Booking Confirmed!</h2>

    <div class="booking-details">
        <p><strong>Booking ID:</strong> #@Model.Id</p>
        <p><strong>Transport:</strong> @Model.TransportType</p>

        @if (Model.TransportType == "Bus" && Model.BusTrip != null)
        {
            <p><strong>From:</strong> @Model.BusTrip.From</p>
            <p><strong>To:</strong> @Model.BusTrip.Destination</p>
            <p><strong>Departure:</strong> @Model.BusTrip.DepartureTime</p>
        }
        else if (Model.TransportType == "Taxi" && Model.TaxiTrip != null)
        {
            <p><strong>Pickup:</strong> @Model.TaxiTrip.PickupLocation</p>
            <p><strong>Dropoff:</strong> @Model.TaxiTrip.DropoffLocation</p>
            <p><strong>Time:</strong> @Model.TaxiTrip.PickupTime</p>
        }
        else if (Model.TransportType == "Railway" && Model.RailwayTrip != null)
        {
            <p><strong>From:</strong> @Model.RailwayTrip.From</p>
            <p><strong>To:</strong> @Model.RailwayTrip.Destination</p>
            <p><strong>Departure:</strong> @Model.RailwayTrip.DepartureTime</p>
            <p><strong>Class:</strong> @Model.RailwayTrip.TrainClass</p>
        }

        <p><strong>Seats:</strong> @Model.NumberOfSeats</p>
        <p><strong>Total Amount:</strong> ₦@Model.TotalAmount.ToString("N0")</p>
        <p><strong>Status:</strong> @Model.Status</p>
    </div>

    <a href="/Home/Dashboard" class="btn-primary">Go to Dashboard</a>
</div>

<style>
    .confirmation-container {
        max-width: 500px;
        margin: 50px auto;
        padding: 30px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .success-icon {
        font-size: 64px;
        margin-bottom: 20px;
    }

    .booking-details {
        text-align: left;
        margin: 30px 0;
        padding: 20px;
        background: #f5f5f5;
        border-radius: 12px;
    }

    .booking-details p {
        margin: 10px 0;
    }

    .btn-primary, .btn-secondary {
        display: inline-block;
        padding: 10px 20px;
        margin: 5px;
        border-radius: 8px;
        text-decoration: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .btn-secondary {
        background: #f0f0f0;
        color: #333;
    }
</style>