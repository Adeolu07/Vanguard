@using _Tripfinity.Services
@model _Tripfinity.Models.Tables.Booking
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Booking Confirmed";
}
@section Styles {
    <link rel="stylesheet" href="~/css/confirmation.css" />
}

<section class="confirmation-success-banner">
    <div class="success-icon-wrapper">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
            <circle cx="12" cy="12" r="10" stroke="#10b981" />
            <polyline points="8 12 11 15 16 9" />
        </svg>
    </div>
    <h1>Booking Confirmed!</h1>
    <p>Your trip has been booked successfully. You can view your trip details below.</p>
</section>

<div class="confirmation-card">
    <div class="confirmation-header">
        <span class="booking-id-label">Booking ID</span>
        <span class="booking-id-value">#@Model.Id</span>
    </div>

    <div class="trip-icon-type">
        @switch (Model.TransportType)
        {
            case TransportType.Bus:
                <span class="icon-bus">
                    🚌 Bus Journey
                </span>
                break;
            case TransportType.Taxi:
                <span class="icon-taxi">
                    🚕 Taxi Ride
                </span>
                break;
            case TransportType.Railway:
                <span class="icon-rail">
                    🚆 Railway Trip
                </span>
                break;
        }
    </div>

    <div class="trip-details-grid">
        @if (Model.TransportType == TransportType.Bus && Model.BusTrip != null)
        {
            <div class="detail-item full-width">
                <span class="detail-label">Route</span>
                <span class="detail-value">@Model.BusTrip.From → @Model.BusTrip.Destination</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Departure</span>
                <span class="detail-value">@Model.BusTrip.DepartureTime</span>
            </div>
        }
        else if (Model.TransportType == TransportType.Taxi && Model.TaxiTrip != null)
        {
            <div class="detail-item full-width">
                <span class="detail-label">Pickup → Drop‑off</span>
                <span class="detail-value">@Model.TaxiTrip.PickupLocation → @Model.TaxiTrip.DropoffLocation</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Pickup Time</span>
                <span class="detail-value">@Model.TaxiTrip.PickupTime</span>
            </div>
        }
        else if (Model.TransportType == TransportType.Railway && Model.RailwayTrip != null)
        {
            <div class="detail-item full-width">
                <span class="detail-label">Route</span>
                <span class="detail-value">@Model.RailwayTrip.From → @Model.RailwayTrip.Destination</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Departure</span>
                <span class="detail-value">@Model.RailwayTrip.DepartureTime</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Class</span>
                <span class="detail-value">@Model.RailwayTrip.TrainClass</span>
            </div>
        }

        <div class="detail-item">
            <span class="detail-label">Seats</span>
            <span class="detail-value">@Model.NumberOfSeats</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Total Amount</span>
            <span class="detail-value highlight">₦@Model.TotalAmount.ToString("N0")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Status</span>
            <span class="status-badge @Model.Status">@Model.Status</span>
        </div>
    </div>

    <div class="confirmation-actions">
        <a href="/Home/Dashboard" class="btn-primary">Go to Dashboard</a>
    </div>
</div>