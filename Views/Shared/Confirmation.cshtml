@model _Tripfinity.Models.Data.Response.GetBalanceResponse
@{
    Layout = "_Layout";
    ViewData["Title"] = "Digital Wallet";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card p-5 text-center shadow border-0 rounded-4" style="max-width: 500px; width: 100%; background: #ffffff;">
        <div class="mb-4">
            <span style="font-size: 4rem;">👛</span>
        </div>
        
        <h2 class="fw-bold mb-3" style="color: #000000;">Tripfinity Wallet</h2>

        @if (ViewBag.HasWallet == false)
        {
            <p class="text-muted mb-4">You don't have an active digital wallet initialized for this profile account yet.</p>
            <form asp-action="InitializeWalletView" asp-controller="Wallet" method="post">
                <button type="submit" class="btn btn-dark w-100 rounded-pill py-3 fw-bold">Setup Wallet Station Now</button>
            </form>
        }
        else if (Model != null && Model.ResponseHeader?.ResponseCode == "00")
        {
            <p class="text-secondary mb-1 text-uppercase small tracking-wide">Available Balance</p>
            <h1 class="display-4 fw-bold mb-4" style="color: #212529;">₦@Model.Balance.ToString("N2")</h1>
            
            <div class="bg-light p-3 rounded-3 mb-4 text-start">
                <small class="text-muted d-block">Account Status message</small>
                <strong class="text-dark font-monospace">@Model.ResponseHeader?.ResponseMessage</strong>
            </div>

            <div class="row g-2">
                <div class="col-6">
                    <button class="btn btn-dark w-100 rounded-pill py-2 fw-semibold">➕ Fund</button>
                </div>
                <div class="col-6">
                    <button class="btn btn-outline-secondary w-100 rounded-pill py-2 fw-semibold">📜 History</button>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-danger" role="alert">
                Wallet Station communication link failed. Please check your service connections.
            </div>
            <a href="/" class="btn btn-secondary w-100 rounded-pill mt-2">Return Home</a>
        }
    </div>
</div>
