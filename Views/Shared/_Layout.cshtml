<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Tripfinity</title>

    <!-- Global styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tripfinity.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        @if (ViewData["HideNavbar"] == null)
        {
<nav class="navbar">
    <div class="logo">🚆 Smart Transport</div>
    <div class="user-info">
        @if (Context.Session.GetString("Username") != null)
        {
            <span class="user-name">👋 Hello, @Context.Session.GetString("Username")</span>
            <a href="/Home/Dashboard" class="btn-secondary" style="margin-left: 10px;">📋 Dashboard</a>
            <a href="/Home/Wallet" class="logout-btn" style="margin-left: 10px;">💳 Wallet</a>
            <a href="/Auth/Logout" class="logout-btn" style="margin-left: 10px;">Sign Out</a>
        }
        else
        {
            <a href="/Auth/DecisionLogin" class="btn-secondary">Sign In</a>
            <a href="/Auth/DecisionSignUp" class="btn-primary">Sign Up</a>
        }
    </div>
</nav>
        }
    </header>

    @if (ViewData["FullPage"] != null)  @* pages like SignIn, SignUp, MarshalSignIn *@
    {
        @RenderBody()
    }
    else
    {
        <div class="container mt-4">
            <main>
                @RenderBody()
            </main>
        </div>
    }

    @if (ViewData["HideFooter"] == null)
    {
        <footer class="footer">
            <div class="container">
                &copy; 2026 - Tripfinity - Smart Transport Booking System
            </div>
        </footer>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
