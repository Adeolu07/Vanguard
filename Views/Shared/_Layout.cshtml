<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Tripfinity</title>

    <!-- Global styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tripfinity.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
         @if (ViewData["Title"]! != null) 
        {
    <nav class="navbar">
        <div class="home">
            <h3>
                <a href="/" style="text-decoration: none"> Tripfinity</a>
            </h3>
        </div>
        <div class="user-info">
            @if (Context.Session.GetString("Username") != null)
            {
                <span class="user-name">👋 Hello, @Context.Session.GetString("Username")</span>
                <a href="/Home/Dashboard" class="btn-secondary" style="margin-left: 10px;">📋 Dashboard</a>
                <a href="/Home/Wallet" class="logout-btn" style="margin-left: 10px;">💳 Wallet</a>
                <a href="/Auth/Logout" class="logout-btn" style="margin-left: 10px;">Sign Out</a>
            }
            else
            {
                <a href="/Auth/DecisionLogin" class="btn-secondary">Sign In</a>
                <a href="/Auth/DecisionSignUp" class="btn-primary">Sign Up</a>
            }
        </div>
    </nav>
        }
    </header>

    @if (ViewData["FullPage"] != null)  @* pages like SignIn, SignUp, MarshalSignIn *@
    {
        @RenderBody()
    }
    else
    {
        <div class="container mt-4">
            <main>
                @RenderBody()
            </main>
        </div>
    }
    
    @if (ViewBag.FirstName != null)
    {
        <aside class="sidebar">
            <div class="brand-logo">
                <div class="logo-icon"></div>
            </div>

            <nav class="sidebar-nav">
                <a href="/Home/Dashboard" class="nav-item active">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M4 13h6c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v8c0 .55.45 1 1 1zm0 8h6c.55 0 1-.45 1-1v-4c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v4c0 .55.45 1 1 1zm10 0h6c.55 0 1-.45 1-1v-8c0-.55-.45-1-1-1h-6c-.55 0-1 .45-1 1v8c0 .55.45 1 1 1zm0-18v4c0 .55.45 1 1 1h6c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1h-6c-.55 0-1 .45-1 1z" /></svg>
                    Dashboard
                </a>
                <a href="/Ticket/Index" class="nav-item">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z" /></svg>
                    My Tickets
                </a>
                <a href="/Home/Wallet" class="nav-item">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" ry="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
                    Wallet
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="user-avatar">
                    <span>@(string.IsNullOrEmpty(ViewBag.FirstName) ? "P" : ViewBag.FirstName.Substring(0, 1))</span>
                </div>
                <div class="user-info-text">
                    <div class="user-name">@ViewBag.FirstName</div>
                    <div class="user-status">VERIFIED MEMBER</div>
                </div>
            </div>
        </aside>
    }

    @if (ViewData["HideFooter"] == null)
    {
        <footer class="footer">
            <div class="container">
                &copy; 2026 - Tripfinity - Smart Transport Booking System
            </div>
        </footer>
    }

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
