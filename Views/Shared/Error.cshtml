@{
    Layout = null;
    var statusCode = (int)(ViewBag.StatusCode ?? 500);
    var title = ViewBag.Title as string ?? "Error";
    var detail = ViewBag.Detail as string ?? "Something went wrong.";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@title – Tripfinity</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; background: #f8fafc; color: #0f172a; display:flex; justify-content:center; align-items:center; min-height:100vh; }
        .card { background:white; border-radius:16px; box-shadow:0 4px 24px rgba(0,0,0,0.06); padding:48px 40px; max-width:480px; text-align:center; }
        .status { display:inline-block; background:#fee2e2; color:#b91c1c; border-radius:8px; padding:4px 16px; font-size:0.8rem; font-weight:600; margin-bottom:16px; }
        h1 { font-size:1.8rem; margin-bottom:12px; }
        p { color:#475569; line-height:1.6; margin-bottom:32px; }
        a { display:inline-block; background:#0f254c; color:white; text-decoration:none; padding:12px 32px; border-radius:8px; font-weight:600; transition:background .2s; }
        a:hover { background:#1e3a5f; }
    </style>
</head>
<body>
<div class="card">
    <div class="status">HTTP @statusCode</div>
    <h1>@title</h1>
    <p>@detail</p>
    <a href="/">Try again</a>
</div>
</body>
</html>