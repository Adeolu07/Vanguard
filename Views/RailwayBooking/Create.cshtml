@{
    Layout = "_Layout";
    ViewData["Title"] = "Book Railway Trip";
    var trip = ViewBag.Trip as _Tripfinity.Models.RailwayTrip;
}

<div class="booking-container">
    <h2>Book Railway Trip</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-error">@ViewBag.Error</div>
    }

    <div class="trip-summary">
        <h3>@trip.From → @trip.Destination</h3>
        <p><strong>Route:</strong> @trip.Route</p>
        <p><strong>Class:</strong> @trip.TrainClass</p>
        <p><strong>Departure:</strong> @trip.DepartureTime.ToString("dddd, MMMM dd yyyy - HH:mm")</p>
        <p><strong>Price per seat:</strong> ₦@trip.Price.ToString("N0")</p>
        <p><strong>Available Seats:</strong> @trip.AvailableSeats</p>
    </div>

    <form method="post" action="/RailwayBooking/Create?tripId=@trip.Id">
        <div class="form-group">
            <label>Number of Seats</label>
            <input type="number" name="seats" min="1" max="@trip.AvailableSeats" value="1" required />
        </div>
        <button type="submit" class="btn-book">Confirm Booking →</button>
    </form>
</div>