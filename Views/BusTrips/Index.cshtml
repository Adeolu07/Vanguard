@model List<_Tripfinity.Models.BusTrip>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title>title</title>
</head>
<body>
<h2>Available Bus Trips</h2>

<table border="1">
    <thead>
    <tr><th>From</th><th>To</th><th>Departure</th><th>Price</th><th>Seats</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var trip in Model)
    {
        <tr>
            <td>@trip.From</td>
            <td>@trip.Destination</td>
            <td>@trip.DepartureTime.ToString("MMM dd, hh:mm tt")</td>
            <td>₦@trip.Price</td>
            <td>@trip.AvailableSeats/@trip.TotalSeats</td>
            <td><a href="#">Select</a></td>
        </tr>
    }
    </tbody>
</table>
</body>
</html>